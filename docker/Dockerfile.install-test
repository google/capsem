# check=skip=InvalidDefaultArgInFrom
# Source-bearing, network-denied image for exact Debian install qualification.
ARG BASE
FROM ${BASE}
ARG INPUT_IDENTITY
LABEL org.capsem.install-image.input-key=${INPUT_IDENTITY}

# The helper owns the systemd harness, exact OS cohort, Python environment and
# pnpm store. This layer owns only the source revision being qualified.
COPY --chown=capsem:capsem . /src
WORKDIR /src

# Materialize the source-specific release-site links from the locked helper
# store without registry access. Runtime rendering performs no install/sync.
USER capsem
RUN cd /src/release-site \
    && pnpm install --offline --frozen-lockfile \
        --store-dir "${CAPSEM_INSTALL_PNPM_STORE}"
USER root

RUN test -x "${UV_PROJECT_ENVIRONMENT}/bin/python" \
    && test -x /src/release-site/node_modules/.bin/astro
