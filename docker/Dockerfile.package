# The package lane's source, copied rather than mounted.
#
# The mount this replaces had to stay read-write, and not by choice: the
# frontend bundler writes atomic temporaries directly beside its target, in
# `frontend/` itself --
#
#   EROFS: read-only file system, open '/src/frontend/_tmp_50_...'
#
# -- so `:ro` was impossible and grafting scratch over `frontend/` would have
# masked the very source the build compiles. There was no flag that fixed it.
# Copying dissolves the problem instead of working around it: `/src` is an
# image layer, so the temporaries have somewhere to go that is not the host's
# checkout, and a host step running concurrently cannot race these inodes.
#
# Unlike the parity lane this keeps the builder image's own user. The package
# build writes `/package-output` and reads the signing keys, and dropping to
# 1000:1000 here takes both away.
ARG BASE
FROM ${BASE}

COPY . /src
WORKDIR /src
