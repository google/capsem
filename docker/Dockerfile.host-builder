# check=skip=InvalidDefaultArgInFrom
# Purpose-built build environment for cross-compiling the Capsem host
# binary (Tauri 2.0 desktop app) targeting Linux x86_64 and arm64.
#
# Runs natively on the host arch. Cross-compilation uses multiarch
# system libraries + Rust --target (no QEMU emulation needed).
#
# Usage:
#   just build-host-image          # build the image (native arch)
#   just cross-compile [arch]      # build Capsem for target arch
#
# Layer strategy: system deps + cross-libs (rare) -> Node/pnpm (quarterly) ->
# Rust toolchain + cargo tools (monthly) -> Python/uv (rare) -> cargo config.
# Source is volume-mounted at runtime, never COPYed.
#
# NOTE: -dev packages for native and foreign arch conflict (headers overlap).
# We install native -dev first, then swap in foreign -dev for cross builds.
# The justfile recipe handles this swap at container runtime.

ARG RUST_IMAGE
ARG UV_IMAGE

FROM node:24-bullseye-slim@sha256:7af27dbbe7d3e4512b83a49b8831463d5cbfdd2dce22675af73558f5ad66e8ef AS node-runtime

FROM ${RUST_IMAGE} AS rust-toolchain

FROM ${UV_IMAGE} AS uv-runtime

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce AS truststore

# The floor every published binary inherits. Jammy carries glibc 2.35, which
# is what lets Ubuntu 22.04 LTS, Debian 12, Mint 21 and Pop!_OS 22.04 run
# Capsem at all -- see issue #181. The toolchain stages above are bullseye
# (2.31) rather than bookworm (2.36) for the same reason: a rustc that needs a
# newer glibc than the image it is copied into cannot run there.
FROM ubuntu:22.04@sha256:3b06811b2afd352be909dd088a004166d665dc76d38b13eada33522a9d915c6f

ARG APT_SNAPSHOT_BASE
ARG APT_SNAPSHOT_ID
ARG PNPM_VERSION
ARG RUST_TOOLCHAIN
ARG RUST_TARGETS
ARG TAURI_CLI_VERSION
ARG CARGO_NEXTEST_VERSION
ARG CARGO_LLVM_COV_VERSION
ARG INPUT_IDENTITY
ARG WORKSPACE_APT_PACKAGES
ARG WORKSPACE_CROSS_APT_PACKAGES

# Ubuntu's minimal base has no system CA bundle, but every configured package
# source is HTTPS. Bootstrap trust from a tiny immutable official image; the
# first Ubuntu package layer then installs Ubuntu's own ca-certificates package.
COPY --from=truststore /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

ENV DEBIAN_FRONTEND=noninteractive

# ---- Multiarch apt sources ----
# Ubuntu arm64 uses ports.ubuntu.com; amd64 uses archive.ubuntu.com.
# We need both repos scoped to their architectures.
COPY sources-multiarch.sh /tmp/
RUN bash /tmp/sources-multiarch.sh "$APT_SNAPSHOT_BASE" "$APT_SNAPSHOT_ID" \
    && rm /tmp/sources-multiarch.sh

# ---- Native build tools + cross-compilation toolchains ----
# Native-arch Tauri dev libraries are installed in the same transaction so
# the complete multiarch indexes are fetched exactly once. Cross builds swap
# these packages at container runtime (see swap-dev-libs.sh).
# ---- Native-arch Tauri dev libraries ----
# The cross compilers are qualified with the native architecture. Unqualified,
# apt is free to satisfy `gcc-x86-64-linux-gnu` with the *foreign* build of it
# -- on jammy it picks `:arm64`, whose cross-dev dependencies are not
# installable, and the layer dies with "held broken packages". A cross compiler
# runs on the native arch by definition, so say so.
RUN test -n "$WORKSPACE_APT_PACKAGES" \
    && test -n "$WORKSPACE_CROSS_APT_PACKAGES" \
    && native="$(dpkg --print-architecture)" \
    && cross="$(for pkg in $WORKSPACE_CROSS_APT_PACKAGES; do printf '%s:%s ' "$pkg" "$native"; done)" \
    && apt-get update && apt-get install -y --no-install-recommends \
    $WORKSPACE_APT_PACKAGES \
    $cross \
    curl \
    wget \
    ca-certificates \
    git \
    sqlite3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# ---- Node.js 24 + pnpm 10 ----
# Copy the complete runtime tree from an immutable official image. Keeping the
# tree intact preserves npm/npx's relative symlink targets while avoiding a
# NodeSource setup script that performs another full multiarch apt refresh.
COPY --from=node-runtime /usr/local/ /usr/local/
RUN test -n "$PNPM_VERSION" && npm install -g "pnpm@${PNPM_VERSION}"

# ---- Rust toolchain (kept identical to rust-toolchain.toml and CI) ----
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:$PATH"

COPY --from=rust-toolchain /usr/local/rustup/ /usr/local/rustup/
COPY --from=rust-toolchain /usr/local/cargo/ /usr/local/cargo/
RUN rustc_version="$(rustc --version)" \
    && case "$rustc_version" in "rustc ${RUST_TOOLCHAIN} "*) ;; *) exit 1 ;; esac \
    && test -n "$RUST_TARGETS" \
    && rustup target add --toolchain "$RUST_TOOLCHAIN" $RUST_TARGETS \
    && rustup component add --toolchain "$RUST_TOOLCHAIN" llvm-tools

# No `cargo fetch` here, deliberately. Baking the dependency graph needs the
# whole crate tree -- the workspace manifest lists members, and `--locked`
# fails with `No such file or directory` without them -- and copying the
# checkout into this image to save a fetch is the wrong trade.
#
# The named volumes that used to carry it are still gone, and for a better
# reason than caching: `capsem-cargo-registry`, `-cargo-git` and `-rustup`
# mounted over `/usr/local/cargo` and `/usr/local/rustup`, which is exactly
# where the layers above install the toolchain, the cross-targets, tauri-cli
# and the Cargo tools. The image carried all of it and every container saw the
# volume instead.

RUN for attempt in 1 2 3; do CARGO_NET_RETRY=10 cargo install tauri-cli --version "${TAURI_CLI_VERSION}" --locked && exit 0; sleep $((attempt * 5)); done; exit 1
RUN for attempt in 1 2 3; do CARGO_NET_RETRY=10 cargo install cargo-nextest --version "${CARGO_NEXTEST_VERSION}" --locked && exit 0; sleep $((attempt * 5)); done; exit 1
RUN installed=0; for attempt in 1 2 3; do CARGO_NET_RETRY=10 cargo install cargo-llvm-cov --version "${CARGO_LLVM_COV_VERSION}" --locked && { installed=1; break; }; sleep $((attempt * 5)); done; \
    [ "$installed" = 1 ] && rm -rf /usr/local/cargo/registry/cache /usr/local/cargo/registry/src

# ---- Exact uv binary (for capsem-builder scripts) ----
COPY --from=uv-runtime /uv /uvx /usr/local/bin/
RUN uv --version

LABEL org.capsem.host-builder.input-key="${INPUT_IDENTITY}"

# ---- Helper script to swap -dev libs for cross-compilation ----
# Keep this after the expensive stable toolchain layers so edits to the swap
# contract do not rebuild Node, Rust, Tauri CLI, or Python tooling.
COPY swap-dev-libs.sh /usr/local/bin/swap-dev-libs
RUN chmod +x /usr/local/bin/swap-dev-libs

# ---- Cargo cross-compilation config ----
ENV CARGO_TARGET_DIR=/cargo-target
ENV PKG_CONFIG_ALLOW_CROSS=1

RUN mkdir -p /usr/local/cargo && printf '%s\n' \
    '[target.x86_64-unknown-linux-gnu]' \
    'linker = "x86_64-linux-gnu-gcc"' \
    '' \
    '[target.aarch64-unknown-linux-gnu]' \
    'linker = "aarch64-linux-gnu-gcc"' \
    '' \
    '[target.aarch64-unknown-linux-musl]' \
    'linker = "rust-lld"' \
    '' \
    '[target.x86_64-unknown-linux-musl]' \
    'linker = "rust-lld"' \
    > /usr/local/cargo/config.toml

# ---- Extension point: macOS cross-compilation (future) ----
# To add osxcross for macOS targets:
#   1. Add build arg: ARG ENABLE_MACOS=0
#   2. Conditionally install osxcross + macOS SDK
#   3. Add Rust targets: x86_64-apple-darwin, aarch64-apple-darwin
#   4. Configure linker in cargo config above
# Note: codesigning + notarization must happen outside the container.

# /src is always a bind mount of the host checkout. On Linux the host UID does
# not match this container's user, so git refuses the repository as "dubious
# ownership". That failure is quiet where it matters most: capsem's build.rs
# falls back to embedding "unknown" for the build hash, leaving the separate
# provenance check as the only thing standing between that and a released
# binary with no source identity.
RUN git config --system --add safe.directory /src

WORKDIR /src
