#!/usr/bin/env python3
"""Record disabled/enabled text inspection through the existing Rust traffic engine."""

from __future__ import annotations

import argparse
import json
import shlex
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "tests"))
sys.path.insert(0, str(ROOT))

import psutil
from capsem_builder.gate import config as gate_config
from helpers.content_filter_session import FIXTURE_HOST, filter_session
from helpers.process_resources import ProcessTreeSampler
from helpers.service import exec_output_text

from benchmarks.helpers.guest_measurements import mitm_runtime_failures
from benchmarks.helpers.guest_runtime import process_tree_sampler
from tests.fixtures.oci.pinned_image import reference_image

SETTINGS = gate_config.load(ROOT).benchmark.content_filter
ARTIFACT = "/tmp/capsem-content-filter-collector.json"
SCENARIOS = ("content_text", "content_stream")
STREAM_FRAMING_BYTES = len(b"data: begin\n\ndata: \n\ndata: end\n\n")


def command(size: int, concurrency: int) -> str:
    return shlex.join(
        [
            "capsem-bench",
            "protocol",
            "--lane",
            "guest_capsem",
            "--base-url",
            f"https://{FIXTURE_HOST}",
            "--query",
            f"bytes={size}&delay_ms={SETTINGS.stream_delay_ms}",
            "--requests",
            str(SETTINGS.requests),
            "--concurrency",
            str(concurrency),
            "--timeout-ms",
            str(SETTINGS.timeout_ms),
            "--scenarios",
            ",".join(SCENARIOS),
            "--collector-out",
            ARTIFACT,
        ]
    )


def validate(document: dict, size: int, concurrency: int) -> dict:
    """Reject errors, lost samples, wrong byte counts and retry-concealed refusals."""
    report = json.loads(document["sidecar"])["mock_server_protocol"]
    assert report["lane"] == "guest_capsem", report
    assert report["concurrency"] == concurrency, report
    assert report["query"] == f"bytes={size}&delay_ms={SETTINGS.stream_delay_ms}", (
        report
    )
    assert set(report["selected_scenarios"]) == set(SCENARIOS), report
    rows = {row["name"]: row for row in report["scenarios"]}
    assert set(rows) == set(SCENARIOS), rows
    for name, row in rows.items():
        assert row["failed"] == 0 and row["errors"] == {}, row
        assert row["successful"] == row["total_requests"] == SETTINGS.requests, row
        assert row["transport_retries"] == 0, row
        expected = size + (STREAM_FRAMING_BYTES if name == "content_stream" else 0)
        assert row["transfer_bytes"] == expected * SETTINGS.requests, row
        for field in ("first_body_byte_ms", "latency_ms"):
            metric = document["metrics"][f"guest_capsem.{name}.{field}"]
            assert metric["unit"] == "milliseconds", metric
            assert len(metric["samples"]) == SETTINGS.requests, metric
    return report


def measure(env, size: int, concurrency: int) -> tuple[dict, dict]:
    sampler = process_tree_sampler(env.service)
    fixture_sampler = ProcessTreeSampler(psutil.Process(env.mock_process.pid))
    sampler.start()
    fixture_sampler.start()
    try:
        result = env.client.post(
            f"/vms/{env.vm_id}/exec",
            {
                "target": "vm",
                "command": command(size, concurrency),
                "timeout_secs": 180,
            },
            timeout=200,
        )
        assert result["exit_code"] == 0, result
    finally:
        resources = sampler.stop()
        fixture_resources = fixture_sampler.stop()
    result = env.client.post(
        f"/vms/{env.vm_id}/exec",
        {
            "target": "vm",
            "command": f"cat {ARTIFACT}",
            "timeout_secs": 10,
        },
        timeout=20,
    )
    assert result["exit_code"] == 0, result
    document = json.loads(exec_output_text(result))
    report = validate(document, size, concurrency)
    metrics = dict(document["metrics"])
    metrics.update({f"resources.{key}": value for key, value in resources.items()})
    metrics.update(
        {f"fixture.{key}": value for key, value in fixture_resources.items()}
    )
    return metrics, report


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--quick", action="store_true", help="unused; requires native VMs"
    )
    parser.parse_args()
    metrics, reports = {}, {}
    with tempfile.TemporaryDirectory(prefix="capsem-filter-bench-") as root:
        for profile in SETTINGS.profiles:
            with filter_session(
                Path(root) / profile.name,
                profile.plugin,
                profile.mode,
                capture_requests=False,
            ) as env:
                for size in SETTINGS.body_bytes:
                    for concurrency in SETTINGS.concurrency:
                        prefix = f"{profile.name}.bytes_{size}.clients_{concurrency}"
                        samples, report = measure(env, size, concurrency)
                        metrics.update(
                            {f"{prefix}.{key}": value for key, value in samples.items()}
                        )
                        reports[prefix] = report
                env.ledger()  # producer drain before counters/log assertions
                info = env.client.get(f"/plugins/{profile.plugin}/info")
                executions = info["runtime"]["execution_count"]
                assert (
                    executions == 0 if profile.mode == "disable" else executions > 0
                ), info
                assert info["runtime"]["detection_count"] == 0, info
                log = env.service.stop_and_read_log()
                assert not mitm_runtime_failures(log), (
                    "hidden traffic-descriptor refusal invalidated run"
                )
    print(
        json.dumps(
            {
                "metrics": metrics,
                "sidecar": json.dumps(
                    {
                        "settings": SETTINGS.model_dump(),
                        "reference_image": reference_image.pinned(),
                        "profiles": reports,
                        "streaming": "enabled text inspection buffers complete bounded SSE bodies before forwarding",
                    }
                ),
            }
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
