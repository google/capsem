#!/usr/bin/env python3
"""Raw crypto samples. Build the crypto owner's compare_hashes example first.

CAPSEM_CRYPTO_BENCH_FILES supplies a JSON array of immutable EROFS paths.
CAPSEM_CRYPTO_BENCH_SAMPLES can replay retained raw samples into the normal
benchmark store without taking another measurement.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

if saved := os.environ.get("CAPSEM_CRYPTO_BENCH_SAMPLES"):
    print(Path(saved).read_text())
else:
    root = Path(__file__).resolve().parents[2]
    binary = os.environ.get("CAPSEM_CRYPTO_BENCH_BINARY")
    if binary is None:
        subprocess.run(
            [sys.executable, str(root / "build_system/scripts/ci/run-bounded-command.py"),
             "--timeout-seconds", "180", "--", "cargo", "build", "--locked", "-p",
             "capsem-crypto", "--example", "compare_hashes", "--features", "benchmark"],
            cwd=root, check=True, timeout=190, stdout=sys.stderr,
        )
        binary = str(root / "cache/target/cargo/debug/examples/compare_hashes")
    files = json.loads(os.environ.get("CAPSEM_CRYPTO_BENCH_FILES", "[]"))
    if not isinstance(files, list) or not all(isinstance(path, str) for path in files):
        raise ValueError("CAPSEM_CRYPTO_BENCH_FILES must be an array of paths")
    subprocess.run([binary, *files], check=True, timeout=180)
