#!/usr/bin/env python3
"""Measure two VMs talking over a private network's switch.

Two VMs join one network, each plugged into its switch by one cable, and the
guest's own `capsem-bench-rs` drives TCP and UDP between their addresses.
Beside original byte/latency observations it records guest TCP retransmissions,
bounded observed host-service resources, and the switch's per-reason drops.
Guest pump CPU and unowned out-of-tree VZ helpers remain explicitly unavailable;
global process names are not attribution. Raw samples only; Rust owns statistics.
"""

from __future__ import annotations

import argparse
import json
import sys
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tests"))
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from capsem_builder.gate import config as gate_config
from helpers.constants import (
    EXEC_READY_TIMEOUT,
)
from helpers.service import ServiceInstance, exec_output_text, wait_exec_ready

from benchmarks.helpers.guest_resources import GuestResources
from benchmarks.helpers.network_observations import NetworkObservations, counter

ROOT = Path(__file__).resolve().parents[2]
SETTINGS = gate_config.load(ROOT).benchmark

THROUGHPUT_PORT = 5201
ECHO_PORT = 5202
LANES = (("upload", 1), ("upload", 4), ("download", 4))
DROPS = ("short", "source_mac", "source_address", "unknown", "queue_full", "storm")


def guest(client, vm, command, timeout=60):
    result = client.post(f"/vms/{vm}/exec", {"command": command, "timeout_secs": timeout}, timeout=timeout + 5)
    if result is None or result.get("exit_code") != 0:
        raise RuntimeError(f"{vm}: {command!r} -> {result}")
    text = exec_output_text(result)
    if len(text.encode("utf-8")) > SETTINGS.run.max_collector_bytes:
        raise ValueError("original guest network output exceeds configured byte budget")
    return text


def retransmits(client, vm):
    snmp = guest(client, vm, "cat /proc/net/snmp").splitlines()
    names, values = [line.split() for line in snmp if line.startswith("Tcp:")][:2]
    return counter(int(values[names.index("RetransSegs")]))


def history(client, network):
    """Every row of the network's history, page by page: a cable that flaps
    under load writes rows enough to push the leaves off the first page."""
    events, cursor, seen = [], "", set()
    for _ in range(SETTINGS.run.max_samples_per_metric):
        page = client.get(f"/networks/{network}/logs" + (f"?cursor={cursor}" if cursor else ""))
        rows = page.get("events")
        if not isinstance(rows, list) or len(events) + len(rows) > SETTINGS.run.max_samples_per_metric:
            raise ValueError("missing or overbudget network history rows")
        events.extend(rows)
        cursor = page.get("next_cursor")
        if not cursor:
            return events
        if not isinstance(cursor, str) or cursor in seen:
            raise ValueError("network history cursor repeated or invalid")
        seen.add(cursor)
    raise ValueError("network history page budget exceeded")


def member(client, network, vm_id):
    for row in client.get(f"/networks/{network}")["members"]:
        if row["vm_id"] == vm_id:
            return row
    return None


def throughput(client, vm, address, direction, streams, seconds):
    return json.loads(
        guest(
            client,
            vm,
            f"capsem-bench-rs throughput --direction {direction} --streams {streams} "
            f"--seconds {seconds} --address {address}:{THROUGHPUT_PORT}",
            timeout=seconds + 60,
        )
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--quick", action="store_true", help="one short trial")
    parser.add_argument("--trials", type=int, default=None)
    parser.add_argument("--seconds", type=int, default=None)
    args = parser.parse_args()
    trials = args.trials if args.trials is not None else (1 if args.quick else 3)
    seconds = args.seconds if args.seconds is not None else (2 if args.quick else 5)

    if not 0 < trials <= SETTINGS.run.max_samples_per_metric or seconds <= 0:
        raise ValueError("network trials/duration exceed supported bounds")
    observations = NetworkObservations(SETTINGS.run)
    add = observations.add

    service = ServiceInstance()
    suffix = uuid.uuid4().hex[:6]
    sender, receiver = f"bench-net-a-{suffix}", f"bench-net-b-{suffix}"
    try:
        service.start()
        client = service.client()
        ids = {}
        for name in (sender, receiver):
            created = client.post(
                "/vms/create", {"name": name, "ram_mb": 2048, "cpus": 4}
            )
            ids[name] = created["id"]
            if not wait_exec_ready(client, name, timeout=EXEC_READY_TIMEOUT):
                raise RuntimeError(f"{name} never became exec-ready")
        network = client.post("/networks", {"name": f"bench{suffix}"})["id"]
        for name in (sender, receiver):
            client.put(f"/networks/{network}/members/{ids[name]}")
        deadline = time.monotonic() + 90
        while any((member(client, network, ids[name]) or {}).get("state") != "ready" for name in ids):
            if time.monotonic() > deadline:
                raise RuntimeError("members never plugged into the switch")
            time.sleep(0.2)
        address = member(client, network, ids[receiver])["address"]
        guest(
            client,
            receiver,
            f"setsid sh -c 'capsem-bench-rs throughput --serve 0.0.0.0:{THROUGHPUT_PORT} & "
            f"capsem-bench-rs udp --serve 0.0.0.0:{ECHO_PORT}' </dev/null >/dev/null 2>&1 &",
        )
        time.sleep(1)

        def measure(lane, trial, operation):
            resources = GuestResources(service, SETTINGS.criterion.resources)
            resources.start()
            try:
                result = operation()
            finally:
                metrics = resources.stop()
            for key, metric in metrics.items():
                if len(metric["samples"]) != 1:
                    raise ValueError("partial host resource measurement")
                add(lane + "." + key, metric["unit"], metric["samples"][0])
            return result, resources.receipt()

        for trial in range(trials):
            print(f"network trial {trial + 1}/{trials}", file=sys.stderr)
            for direction, streams in LANES:
                lane = f"tcp.{direction}.s{streams}"
                before = {side: retransmits(client, vm) for side, vm in (("sender", sender), ("receiver", receiver))}
                report, receipt = measure(lane, trial, lambda direction=direction, streams=streams: throughput(
                    client, sender, address, direction, streams, seconds))
                facts = observations.tcp(lane, report, direction=direction, streams=streams, seconds=seconds)
                after = {side: retransmits(client, vm) for side, vm in (("sender", sender), ("receiver", receiver))}
                deltas = {side: counter(after[side] - value) for side, value in before.items()}
                add(lane + ".retransmits", "count", sum(deltas.values()))
                observations.window(lane, trial, receipt, producer=facts, guest_tcp={side: {
                    "before": before[side], "after": after[side], "delta": deltas[side]
                } for side in before})
            latency, receipt = measure("tcp.latency", trial, lambda: throughput(
                client, sender, address, "latency", 1, 1))
            facts = observations.tcp("tcp.latency", latency, direction="latency", streams=1, seconds=1)
            observations.window("tcp.latency", trial, receipt, producer=facts)
            udp, receipt = measure("udp", trial, lambda: json.loads(guest(
                client, sender,
                f"capsem-bench-rs udp --address {address}:{ECHO_PORT} --count 200 --size 1400 "
                "--interval-ms 2 --wait-ms 2000")))
            facts = observations.udp(udp, count=200)
            observations.window("udp", trial, receipt, producer=facts)

        # The switch counted every frame it could not deliver; its counters
        # arrive in each port's close row: one per leave, and one per cable
        # that ended on its own mid-run (a flap, replugged by the service).
        for name in (sender, receiver):
            client.delete(f"/networks/{network}/members/{ids[name]}")
        closes, left = [], []
        deadline = time.monotonic() + 20
        while len(left) < 2 and time.monotonic() < deadline:
            events = history(client, network)
            closes = [e for e in events if e["event_type"] == "network.close" and "frames" in e["event"]]
            left = [e for e in closes if e["event"]["decision"]["reason"] == "unlinked"]
            time.sleep(0.2)
        add("switch.cable_flaps", "count", len(closes) - len(left))
        if len(left) < 2:
            for event in events:
                print(json.dumps(event), file=sys.stderr)
            log = service.tmp_dir / "service.log"
            for line in log.read_text(errors="replace").splitlines() if log.exists() else []:
                if "cable" in line or "switch" in line:
                    print(line, file=sys.stderr)
            raise RuntimeError(f"the switch reported {len(left)} of 2 leaves ({len(closes)} closes)")
        for reason in DROPS:
            add(f"switch.dropped.{reason}", "count", sum(counter(e["event"]["frames"]["dropped"][reason]) for e in closes))
        observations.complete(
            [*(f"tcp.{direction}.s{streams}" for direction, streams in LANES), "tcp.latency", "udp"],
            trials=trials,
        )
    finally:
        service.stop()

    json.dump({"metrics": observations.metrics, "sidecar": observations.sidecar()}, sys.stdout, allow_nan=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
