#!/usr/bin/env python3
"""Measure one dimension inside a VM, via the guest `capsem-bench` package.

One program for eight dimensions: it reads the mode from the name it was
invoked as, so `disk`, `rootfs`, `storage`, `startup`, `snapshot`, `mcp-load`,
`mitm-load` and `dns-load` are symlinks to this file. Eight copies of "boot a
VM, run a mode, pull the JSON out" would drift apart, which is how the three
load modes ended up with committed baselines and no caller.

`mitm-load`, `mcp-load` and `dns-load` are excluded from the guest package's
`all`, so nothing has ever run them automatically. Naming them here is what
gives them a caller.

The guest reports one number per operation rather than a sample array, so most
of these are single-observation metrics. `n` says so rather than implying a
distribution that was never measured.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import sys
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
# Both, because the test helpers import each other as `helpers.*` and the
# repository scripts as `scripts.*`; pytest puts the rootdir on the path and a
# collector run outside pytest has to do the same.
sys.path.insert(0, str(ROOT / "tests"))
sys.path.insert(0, str(ROOT))

from helpers.constants import DEFAULT_CPUS, DEFAULT_RAM_MB, EXEC_READY_TIMEOUT
from helpers.service import ServiceInstance, wait_exec_ready

# Units the guest reports, by the suffix its key carries.
UNITS = {
    "_mbps": "megabits_per_second",
    "_ms": "milliseconds",
    "_bytes": "bytes",
    "iops": "operations",
    "rps": "requests_per_second",
}

FORWARDED_ENV = (
    "CAPSEM_BENCH_CONCURRENCY",
    "CAPSEM_BENCH_DURATION_S",
    "CAPSEM_BENCH_MITM_TARGET",
)

# The mitm-load target: a name the mock server's DNS answers (with 127.0.0.1,
# which the guest's NAT sends through capsem-net-proxy like any other address)
# and an upstream override that lands the proxied request on the mock server's
# plain-HTTP listener. Every request therefore traverses guest DNS, the
# net-proxy, the host MITM (TLS termination, policy, telemetry) and a real
# upstream. The previous target was a non-existent public domain: the guest's
# resolver returned NXDOMAIN and the client failed before opening a socket,
# so the "MITM" numbers were DNS-failure numbers and the proxy never ran.
MITM_FIXTURE_HOST = "fixture.capsem.test"
MITM_FIXTURE_TARGET = f"https://{MITM_FIXTURE_HOST}/tiny"


def mitm_fixture_corp_toml(ready: dict) -> str:
    """Corp config routing guest DNS and the fixture host to the mock server."""
    return (
        "[network.dns]\n"
        f"upstreams = [{json.dumps(ready['dns_udp_addr'])}]\n"
        "\n"
        f'[network.upstream_overrides."{MITM_FIXTURE_HOST}:443"]\n'
        f"dial = {json.dumps(ready['http_addr'])}\n"
        'protocol = "http"\n'
    )


def failed_load_levels(section: dict) -> list[int]:
    """Concurrency levels whose every request failed.

    A level where nothing succeeded measured the failure path, not the rail
    under test; recording it would ratchet the wrong number.
    """
    return [
        int(row.get("concurrency", -1))
        for row in section.get("concurrency_levels", [])
        if int(row.get("total_requests", 0)) > 0
        and int(row.get("errors", 0)) >= int(row.get("total_requests", 0))
    ]


def guest_command(mode: str) -> str:
    """One safely quoted command with only documented benchmark controls."""
    assignments = [
        f"{name}={value}"
        for name in FORWARDED_ENV
        if (value := os.environ.get(name)) is not None
    ]
    return shlex.join(["env", *assignments, "capsem-bench", mode])


def unit_for(key: str) -> str | None:
    """The unit a key declares, or `None` when it declares none.

    A key with no recognised unit is not a measurement. The guest reports the
    kernel's block-queue settings alongside its timings -- `rotational`,
    `nr_requests`, `read_ahead_kb` -- and walking everything numeric turned
    `storage` into 640 "metrics", most of them static configuration that would
    then be ratcheted like a duration.
    """
    for suffix, unit in UNITS.items():
        if key.endswith(suffix):
            return unit
    return None


def flatten(node, prefix: str = "") -> dict[str, float]:
    """Every number the guest reported, under a dotted key.

    The guest sections nest differently per mode -- disk by operation, storage
    by mount, startup by command -- so the shape is walked rather than known.
    """
    found: dict[str, float] = {}
    if isinstance(node, dict):
        for key, value in node.items():
            found.update(flatten(value, f"{prefix}.{key}" if prefix else str(key)))
    elif isinstance(node, list):
        for index, value in enumerate(node):
            found.update(flatten(value, f"{prefix}.{index}" if prefix else str(index)))
    elif isinstance(node, bool):
        pass  # a flag is not a measurement
    elif isinstance(node, (int, float)):
        found[prefix] = float(node)
    return found


def main() -> int:
    mode = Path(sys.argv[0]).name
    parser = argparse.ArgumentParser(description=f"measure {mode} inside a VM")
    parser.add_argument(
        "--quick", action="store_true", help="unused; guest modes are fixed"
    )
    parser.add_argument("--timeout", type=int, default=600)
    args = parser.parse_args()

    name = f"bench-{mode}-{uuid.uuid4().hex[:8]}"
    service = ServiceInstance()
    mock_proc = None
    if mode == "mitm-load":
        from helpers.mock_server import start_mock_server

        mock_proc, ready = start_mock_server()
        corp_path = service.tmp_dir / "bench-corp.toml"
        corp_path.write_text(mitm_fixture_corp_toml(ready), encoding="utf-8")
        os.environ["CAPSEM_CORP_CONFIG"] = str(corp_path)
        os.environ.setdefault("CAPSEM_BENCH_MITM_TARGET", MITM_FIXTURE_TARGET)
    service.start()
    client = service.client()

    try:
        print(f"provisioning {name}", file=sys.stderr)
        client.post(
            "/vms/create",
            {"name": name, "ram_mb": DEFAULT_RAM_MB, "cpus": DEFAULT_CPUS},
        )
        if not wait_exec_ready(client, name, timeout=EXEC_READY_TIMEOUT):
            raise RuntimeError(f"{name} never became exec-ready")

        print(f"running capsem-bench {mode}", file=sys.stderr)
        benchmark_result = client.post(
            f"/vms/{name}/exec",
            {"command": guest_command(mode), "timeout_secs": args.timeout},
            timeout=args.timeout + 10,
        )
        if not benchmark_result or benchmark_result.get("exit_code") != 0:
            raise RuntimeError(
                f"capsem-bench {mode} failed: "
                f"exit={None if not benchmark_result else benchmark_result.get('exit_code')}\n"
                f"{(benchmark_result or {}).get('stderr', '')[:500]}"
            )

        artifact_result = client.post(
            f"/vms/{name}/exec",
            {"command": "cat /tmp/capsem-benchmark.json", "timeout_secs": 15},
            timeout=25,
        )
        if not artifact_result or artifact_result.get("exit_code") != 0:
            raise RuntimeError(
                f"read capsem-bench {mode} artifact failed: "
                f"exit={None if not artifact_result else artifact_result.get('exit_code')}\n"
                f"{(artifact_result or {}).get('stderr', '')[:500]}"
            )
        document = json.loads(artifact_result.get("stdout", ""))
    finally:
        with __import__("contextlib").suppress(Exception):
            client.delete(f"/vms/{name}/delete")
        service.stop()
        if mock_proc is not None:
            from helpers.mock_server import stop_process

            stop_process(mock_proc)

    # The guest writes one document per run keyed by mode; take that section
    # when present so keys are not prefixed with the mode twice.
    section = document.get(mode.replace("-", "_"), document)
    if failed := failed_load_levels(section):
        raise RuntimeError(
            f"capsem-bench {mode}: every request failed at concurrency {failed}; "
            "the rail under test was never reached, so nothing here is a measurement"
        )
    numbers = flatten(section)
    if not numbers:
        raise RuntimeError(
            f"capsem-bench {mode} reported no numbers: "
            f"artifact={json.dumps(document, sort_keys=True)[:1000]!r}; "
            f"stderr={(benchmark_result or {}).get('stderr', '')[:1000]!r}"
        )

    measured = {
        key: {"unit": unit, "samples": [value]}
        for key, value in sorted(numbers.items())
        if (unit := unit_for(key)) is not None
    }
    if not measured:
        raise RuntimeError(
            f"capsem-bench {mode} reported {len(numbers)} numbers, none of which "
            "name a unit; nothing here is a measurement"
        )
    print(
        f"{len(measured)} measurements from {len(numbers)} numbers",
        file=sys.stderr,
    )
    json.dump({"metrics": measured}, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
