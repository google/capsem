#!/usr/bin/env python3
"""Measure one dimension inside a VM, via the guest `capsem-bench` package.

One program for nine dimensions: it reads the mode from the name it was
invoked as, so `disk`, `rootfs`, `storage`, `startup`, `snapshot`, `mcp-load`,
`mitm-load`, `dns-load` and `protocol` are symlinks to this file. Nine copies of "boot a
VM, run a mode, pull the JSON out" would drift apart, which is how the three
load modes ended up with committed baselines and no caller.

`mitm-load`, `mcp-load` and `dns-load` are excluded from the guest package's
`all`, so nothing has ever run them automatically. Naming them here is what
gives them a caller.

Disk and storage preserve bounded original per-operation sample arrays. Other
diagnostic modes still report aggregate observations; their `n` never implies
a distribution that was not measured.
"""

from __future__ import annotations

import argparse
import contextlib
import json
import os
import sys
import uuid
from pathlib import Path

# Both, because the test helpers import each other as `helpers.*` and the
# repository scripts as `scripts.*`; pytest puts the rootdir on the path and a
# collector run outside pytest has to do the same.
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tests"))
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "guest/artifacts"))

from capsem_builder.gate import config as gate_config
from helpers.constants import DEFAULT_RAM_MB, EXEC_READY_TIMEOUT
from helpers.service import ServiceInstance, exec_output_text, wait_exec_ready

from benchmarks.helpers.guest_measurements import (
    failed_load_levels,
    flatten,
    load_quality_metrics,
    mitm_runtime_failures,
    numeric_metrics,
    resource_samples,
)
from benchmarks.helpers.guest_resources import MEASURED_IO_MODES, GuestResources
from benchmarks.helpers.guest_runtime import (
    LOAD_MODES,
    MITM_FIXTURE_TARGET,
    PROTOCOL_COLLECTOR_PATH,
    PROXY_ERROR_MODES,
    failed_load_diagnostics,
    guest_command,
    guest_cpus,
    mitm_fixture_corp_toml,
    process_tree_sampler,
)

PROJECT_ROOT = Path(__file__).resolve().parents[2]
BENCHMARK_SETTINGS = gate_config.load(PROJECT_ROOT).benchmark
PROTOCOL_SETTINGS = BENCHMARK_SETTINGS.protocol


def apply_protocol_defaults() -> None:
    """Apply the config-owned routine model and MCP sample cohort."""
    os.environ.setdefault(
        "CAPSEM_BENCH_TOTAL_REQUESTS", str(PROTOCOL_SETTINGS.requests)
    )
    os.environ.setdefault(
        "CAPSEM_BENCH_CONCURRENCY", str(PROTOCOL_SETTINGS.concurrency)
    )
    os.environ.setdefault("CAPSEM_BENCH_TIMEOUT_MS", str(PROTOCOL_SETTINGS.timeout_ms))
    os.environ.setdefault(
        "CAPSEM_BENCH_SCENARIOS", ",".join(PROTOCOL_SETTINGS.scenarios)
    )


# The mitm-load target: a name the mock server's DNS answers (with 127.0.0.1,
# which the guest's NAT sends through capsem-net-proxy like any other address)
# and an upstream override that lands the proxied request on the mock server's
# plain-HTTP listener. Every request therefore traverses guest DNS, the
# net-proxy, the host MITM (TLS termination, policy, telemetry) and a real
# upstream. The previous target was a non-existent public domain: the guest's
# resolver returned NXDOMAIN and the client failed before opening a socket,
# so the "MITM" numbers were DNS-failure numbers and the proxy never ran.
# The load dimensions run their generator inside the guest: two hundred
# Python threads doing TLS, plus the guest proxies, on the default two vCPUs
# measured the generator's starvation, not the host rails. Give those guests
# half the host's cores, at least the default and at most eight.


def main() -> int:
    mode = Path(sys.argv[0]).name
    parser = argparse.ArgumentParser(description=f"measure {mode} inside a VM")
    parser.add_argument(
        "--quick", action="store_true", help="unused; guest modes are fixed"
    )
    parser.add_argument("--timeout", type=int, default=600)
    args = parser.parse_args()

    name = f"bench-{mode}-{uuid.uuid4().hex[:8]}"
    service = ServiceInstance()
    mock_proc = None
    service_log = ""
    client = service.client()
    try:
        if mode == "mitm-load":
            from helpers.mock_server import start_mock_server

            mock_proc, ready = start_mock_server()
            corp_path = service.tmp_dir / "bench-corp.toml"
            corp_path.write_text(mitm_fixture_corp_toml(ready), encoding="utf-8")
            os.environ["CAPSEM_CORP_CONFIG"] = str(corp_path)
            os.environ.setdefault("CAPSEM_BENCH_MITM_TARGET", MITM_FIXTURE_TARGET)
        elif mode == "protocol":
            from helpers.mock_server import start_mock_server

            mock_proc, ready = start_mock_server(capture_requests=False)
            os.environ.setdefault("CAPSEM_MOCK_SERVER_BASE_URL", ready["base_url"])
            os.environ.setdefault(
                "CAPSEM_MOCK_SERVER_DNS_UDP_ADDR", ready["dns_udp_addr"]
            )
            apply_protocol_defaults()
        service.start()
        print(f"provisioning {name}", file=sys.stderr)
        created = client.post(
            "/vms/create",
            {"name": name, "ram_mb": DEFAULT_RAM_MB, "cpus": guest_cpus(mode)},
        )
        if not created or not created.get("id"):
            raise RuntimeError(f"provision {name} failed: {created}")
        name = created["id"]
        if not wait_exec_ready(client, name, timeout=EXEC_READY_TIMEOUT):
            raise RuntimeError(f"{name} never became exec-ready")

        print(f"running capsem-bench {mode}", file=sys.stderr)
        resources = (
            GuestResources(service, BENCHMARK_SETTINGS.criterion.resources)
            if mode in MEASURED_IO_MODES
            else process_tree_sampler(service) if mode in LOAD_MODES else None
        )
        resource_metrics = {}
        resource_receipt = None
        if resources is not None:
            resources.start()
        try:
            benchmark_result = client.post(
                f"/vms/{name}/exec",
                {
                    "target": "vm",
                    "command": guest_command(mode, io_limits=BENCHMARK_SETTINGS.run),
                    "timeout_secs": args.timeout,
                },
                timeout=args.timeout + 10,
            )
        finally:
            if resources is not None:
                resource_metrics = resources.stop()
                if isinstance(resources, GuestResources):
                    resource_receipt = resources.receipt()
        if not benchmark_result or benchmark_result.get("exit_code") != 0:
            raise RuntimeError(
                f"capsem-bench {mode} failed: "
                f"exit={None if not benchmark_result else benchmark_result.get('exit_code')}\n"
                f"response={json.dumps(benchmark_result)[:1000]}\n"
                f"resources={json.dumps(resource_samples(resource_metrics), sort_keys=True)}"
            )

        artifact_path = (
            PROTOCOL_COLLECTOR_PATH
            if mode == "protocol"
            else "/tmp/capsem-benchmark.json"
        )
        artifact_result = client.post(
            f"/vms/{name}/exec",
            {
                "target": "vm",
                "command": f"cat {artifact_path}",
                "timeout_secs": 15,
            },
            timeout=25,
        )
        if not artifact_result or artifact_result.get("exit_code") != 0:
            raise RuntimeError(
                f"read capsem-bench {mode} artifact failed: "
                f"exit={None if not artifact_result else artifact_result.get('exit_code')}\n"
                f"response={json.dumps(artifact_result)[:1000]}"
            )
        artifact_text = exec_output_text(artifact_result)
        if len(artifact_text.encode("utf-8")) > BENCHMARK_SETTINGS.run.max_collector_bytes:
            raise ValueError("guest artifact exceeds configured byte budget")
        raw_document = json.loads(artifact_text)
        protocol_collection = raw_document if mode == "protocol" else None
        document = (
            json.loads(protocol_collection["sidecar"])
            if protocol_collection is not None
            else raw_document
        )
        # Reject while the fixture is still live. ServiceInstance sees the
        # active exception during teardown and preserves the ledger/proxy
        # evidence instead of treating this as a clean benchmark shutdown.
        section_name = (
            "mock_server_protocol" if mode == "protocol" else mode.replace("-", "_")
        )
        section = document.get(section_name, document)
        io_metrics, io_facts = {}, {}
        if mode in {"disk", "storage"}:
            from benchmarks.helpers.storage_raw import extract

            io_metrics, io_facts = extract(mode, section, BENCHMARK_SETTINGS.run)
        if failed := failed_load_levels(section):
            diagnostics = failed_load_diagnostics(service, client, name, mode)
            raise RuntimeError(
                f"capsem-bench {mode}: requests failed at concurrency {failed}; "
                "the rail did not sustain the requested load, so the run is rejected; "
                f"artifact={json.dumps(document, sort_keys=True)}; "
                f"resources={json.dumps(resource_samples(resource_metrics), sort_keys=True)}; "
                f"guest_diagnostics={diagnostics[-20_000:]!r}"
            )
    finally:
        with contextlib.suppress(Exception):
            client.delete(f"/vms/{name}/delete")
        if mode in PROXY_ERROR_MODES:
            service_log = service.stop_and_read_log()
            service.stop()
        else:
            service.stop()
        if mock_proc is not None:
            from helpers.mock_server import stop_process

            stop_process(mock_proc)

    # The guest writes one document per run keyed by mode; take that section
    # when present so keys are not prefixed with the mode twice.
    runtime_failures = (
        mitm_runtime_failures(service_log) if mode in PROXY_ERROR_MODES else []
    )
    if runtime_failures:
        raise RuntimeError(
            f"capsem-bench {mode}: {len(runtime_failures)} internal traffic "
            "descriptor refusal(s) were retried below the client boundary; "
            f"first={runtime_failures[:5]!r}; "
            f"resources={json.dumps(resource_samples(resource_metrics), sort_keys=True)}"
        )
    numbers = flatten(section)
    if not numbers and not io_metrics:
        raise RuntimeError(
            f"capsem-bench {mode} reported no numbers: "
            f"artifact={json.dumps(document, sort_keys=True)[:1000]!r}; "
            f"exec_response={json.dumps(benchmark_result)[:1000]!r}"
        )

    measured = (
        dict(protocol_collection["metrics"])
        if protocol_collection is not None
        else numeric_metrics(mode, numbers)
    )
    if protocol_collection is None:
        measured.update(load_quality_metrics(section))
    if mode == "mitm-load":
        measured["internal.proxy_traffic_refusals"] = {
            "unit": "count",
            "samples": [0],
        }
    measured.update(resource_metrics)
    measured.update(io_metrics)
    if resource_receipt is not None:
        document["host_resources"] = resource_receipt
    if io_facts:
        document["io_capture_facts"] = io_facts
    if not measured:
        raise RuntimeError(
            f"capsem-bench {mode} reported {len(numbers)} numbers, none of which "
            "name a unit; nothing here is a measurement"
        )
    print(
        f"{len(measured)} measurements from {len(numbers)} numbers",
        file=sys.stderr,
    )
    # Retain counts, concurrency and errors without ratcheting them as timings.
    json.dump({"metrics": measured, "sidecar": json.dumps(document)}, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
