#!/usr/bin/env python3
"""Raw bounded HTTP route receipts, direct and via the gateway.

Method/path/fixtures and request counts belong to config/gate.toml. All derived
statistics stay in capsem-bench; client validation runs after receipt clocks.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import sys
import threading
import time
from contextlib import ExitStack, redirect_stdout
from pathlib import Path

# Match pytest's roots for helpers that import `helpers.*` and `scripts.*`.
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tests"))
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

import psutil
from helpers.benchmark_assets import clone_benchmark_assets
from helpers.constants import ASSETS_DIR
from helpers.http_transport import Transport
from helpers.image_session import image_session
from helpers.process_cpu import process_cpu_seconds
from helpers.service import ServiceInstance
from helpers.stopped_workspace import (
    seed_stopped_workspace,
)

from benchmarks.helpers.route_binary_fixture import (
    expected_file_exports,
    finish_binary_files,
    seed_binary_files,
)
from benchmarks.helpers.route_cases import RouteCase, measured_cases
from benchmarks.helpers.route_fixtures import (
    corpus_config,
    network_fixture,
    seed_logs,
    seed_metadata,
)
from benchmarks.helpers.route_gateway import GATEWAY_RESPONSES
from benchmarks.helpers.route_measurements import Observations, route_metrics
from benchmarks.helpers.route_requests import Target, request, request_input, route_load_config
from benchmarks.helpers.route_validation import validate_snapshot, validate_wire
from benchmarks.helpers.stream_measurements import service_gateway

WARMUP = 2


def preflight(target: Target, cases: list[RouteCase], live_id: str | None, network_id: str | None = None) -> None:
    """Validate real schemas/counters outside all measured windows."""
    transport = target.transport_factory()
    payloads = {}
    try:
        for case in cases:
            if not case.supports_target(target.label):
                continue
            path = case.resolve(live_id, network_id)
            if request_input(path)[0] != case.method:
                raise ValueError(f"case method differs from its request: {case.metric_key}")
            receipt = request(transport, target, path, case.response)
            payloads[case.path] = receipt.body if case.response in {"binary", "warc", *GATEWAY_RESPONSES.values()} else validate_wire(case, receipt.body, live_id, network_id)
        validate_snapshot(payloads)
    finally:
        transport.close()


def sample_warm_route(
    target: Target, path: str, samples: int, response: str = "json"
) -> tuple[Observations, dict[str, float]]:
    """Raw kept-alive latency and every participating process's CPU."""
    transport = target.transport_factory()
    try:
        for _ in range(WARMUP):
            request(transport, target, path, response)
        before = {
            name: process_cpu_seconds(proc)
            for name, proc in target.cpu_processes.items()
        }
        latencies = Observations()
        for _ in range(samples):
            latencies.append(request(transport, target, path, response))
        cpu = {
            name: float(process_cpu_seconds(proc) - before[name])
            for name, proc in target.cpu_processes.items()
        }
        return latencies, cpu
    finally:
        transport.close()


def sample_cold_route(target: Target, path: str, samples: int, response: str = "json") -> Observations:
    """Raw latency including a new socket and HTTP connection."""
    latencies = Observations()
    for _ in range(samples):
        transport = target.transport_factory()
        try:
            latencies.append(request(transport, target, path, response))
        finally:
            transport.close()
    return latencies


def sample_concurrent_route(
    target: Target, path: str, samples: int, concurrency: int, response: str = "json"
) -> tuple[Observations, dict[str, float], float]:
    """Raw latency, CPU and RPS with one kept-alive connection per worker."""
    workers = min(samples, concurrency)
    barrier = threading.Barrier(workers + 1)

    def worker(count: int) -> Observations:
        transport = target.transport_factory()
        try:
            request(transport, target, path, response)
            barrier.wait(timeout=30)
            measured = Observations()
            for _ in range(count):
                measured.append(request(transport, target, path, response))
            return measured
        finally:
            transport.close()

    counts = [
        samples // workers + int(index < samples % workers) for index in range(workers)
    ]
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        futures = [executor.submit(worker, count) for count in counts]
        before = {
            name: process_cpu_seconds(proc)
            for name, proc in target.cpu_processes.items()
        }
        started = time.perf_counter()
        barrier.wait(timeout=30)
        latencies = Observations()
        for future in futures:
            latencies.extend(future.result())
        latencies.require_count(samples)
        elapsed = time.perf_counter() - started
    cpu = {
        name: float(process_cpu_seconds(proc) - before[name])
        for name, proc in target.cpu_processes.items()
    }
    return latencies, cpu, samples / elapsed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--quick", action="store_true", help="fewer samples per route")
    parser.add_argument("--samples", type=int, default=None)
    args = parser.parse_args()

    samples = args.samples if args.samples is not None else (16 if args.quick else 128)
    if samples <= 0:
        parser.error("samples must be positive")
    load = route_load_config()
    load_samples = int(load["quick_requests"] if args.quick else load["requests"])
    concurrency = int(load["concurrency"])
    cases = measured_cases()
    if not cases:
        print(
            "no routes are listed as measured in [benchmark.routes]; every one "
            "is still in the unmeasured debt inventory",
            file=sys.stderr,
        )
        return 1

    service = ServiceInstance()
    service.assets_dir = clone_benchmark_assets(
        ASSETS_DIR, service.home_dir / "benchmark-assets"
    )

    metrics: dict[str, dict] = {}
    try:
        seed_stopped_workspace(service.tmp_dir, service.assets_dir, file_count=corpus_config()["workspace_files"])
        seed_metadata(service, corpus_config())
        with redirect_stdout(sys.stderr):
            service.start()
        gateway = service_gateway(service)
        assert service.proc is not None, "service must be running before measurement"
        service_proc = psutil.Process(service.proc.pid)
        gateway_proc = psutil.Process(gateway.pid)
        targets = (
            Target(
                label="service",
                transport_factory=lambda: Transport(socket_path=str(service.uds_path)),
                headers={},
                cpu_processes={"service": service_proc},
            ),
            Target(
                label="gateway",
                service_socket=str(service.uds_path),
                transport_factory=lambda: Transport(
                    host="127.0.0.1", port=gateway.port
                ),
                headers={"Authorization": f"Bearer {gateway.token}"},
                cpu_processes={
                    "gateway": gateway_proc,
                    "downstream_service": service_proc,
                },
            ),
        )
        with ExitStack() as fixtures:
            network_id = fixtures.enter_context(network_fixture(service)) if any(case.path.startswith("/networks/{id}") for case in cases) else None
            live_id = None
            if any(case.live for case in cases):
                live_id = fixtures.enter_context(
                    image_session(service, service.home_dir / "route-registry", "route-live-owner")
                )
            binary = any(case.response == "binary" for case in cases)
            if binary:
                seed_binary_files(service, live_id)
            seed_logs(service, corpus_config())
            for target in targets:
                preflight(target, cases, live_id, network_id)
            for case in cases:
                concrete_path = case.resolve(live_id, network_id)
                path = case.metric_key
                count, requests, workers = case.counts(samples, load_samples, concurrency, args.samples)
                for target in targets:
                    if not case.supports_target(target.label):
                        continue
                    print(f"{target.label} {path}", file=sys.stderr)
                    latencies, cpu = sample_warm_route(target, concrete_path, count, case.response)
                    cold_latencies = sample_cold_route(target, concrete_path, count, case.response)
                    metrics.update(route_metrics(target.label, path, latencies, cold_latencies, cpu, expected=count))
                    concurrent_latencies, concurrent_cpu, rps = sample_concurrent_route(
                        target, concrete_path, requests, workers, case.response
                    )
                    metrics.update(route_metrics(target.label, path, concurrent_latencies, None, concurrent_cpu, rps, expected=requests))
            if binary:
                expected = expected_file_exports(cases, samples=samples, load_requests=load_samples, concurrency=concurrency, warmup=WARMUP, targets=len(targets), override=args.samples)
                finish_binary_files(service, live_id, expected)
    finally:
        service.stop()

    json.dump({"metrics": metrics}, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
