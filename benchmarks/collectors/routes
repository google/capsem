#!/usr/bin/env python3
"""Measure HTTP route latency and per-request CPU, direct and via the gateway.

53 of the 101 service routes had no timing signal of any kind. This measures
the read-only ones that need no VM, both straight to the service and through
the gateway, so the proxy hop's cost is a number rather than a guess.

Which routes are measured comes from `[benchmark.routes] measured` in
`config/gate.toml`, and the fast Citadel guard at
`tests/citadel/test_bench_route_coverage.py` requires every registered route
to be measured, explicitly recorded as measurement debt, or identified as a
reasoned internal service-only control route. Moving a route from debt to
measured is what adding coverage looks like.

The primary latency series uses a kept-alive connection, matching the UI and
the gateway's pooled service client. A separate cold series includes socket
setup so connection regressions remain visible without contaminating route
execution. Every response must be successful JSON; a fast error is a failed
benchmark, not an excellent latency result.

Prints raw per-request milliseconds plus service and gateway CPU deltas;
`capsem-bench` computes every statistic.
"""

from __future__ import annotations

import argparse
import json
import sys
import time
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

import tomllib

ROOT = Path(__file__).resolve().parents[2]
# Both, because the test helpers import each other as `helpers.*` and the
# repository scripts as `scripts.*`; pytest puts the rootdir on the path and a
# collector run outside pytest has to do the same.
sys.path.insert(0, str(ROOT / "tests"))
sys.path.insert(0, str(ROOT))

import psutil
from helpers.gateway import GatewayInstance
from helpers.http_transport import Transport
from helpers.process_cpu import process_cpu_seconds
from helpers.service import ServiceInstance

WARMUP = 2


def measured_routes() -> list[str]:
    config = tomllib.loads((ROOT / "config" / "gate.toml").read_text(encoding="utf-8"))
    return list(config["benchmark"]["routes"]["measured"])


@dataclass(frozen=True)
class Target:
    label: str
    transport_factory: Callable[[], Transport]
    headers: dict[str, str]
    cpu_processes: dict[str, psutil.Process]


def request(transport: Transport, target: Target, path: str) -> None:
    """Require one successful JSON response."""
    status, _, body = transport.request("GET", path, headers=target.headers)
    if not 200 <= status < 300:
        raise RuntimeError(f"{target.label} {path} returned HTTP {status}: {body[:500]!r}")
    try:
        json.loads(body)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"{target.label} {path} returned non-JSON: {body[:500]!r}") from error


def sample_warm_route(target: Target, path: str, samples: int) -> tuple[list[float], dict[str, float]]:
    """Raw kept-alive latency and every participating process's CPU."""
    transport = target.transport_factory()
    try:
        for _ in range(WARMUP):
            request(transport, target, path)
        before = {name: process_cpu_seconds(proc) for name, proc in target.cpu_processes.items()}
        latencies = []
        for _ in range(samples):
            started = time.perf_counter()
            request(transport, target, path)
            latencies.append((time.perf_counter() - started) * 1000.0)
        cpu = {
            name: float(process_cpu_seconds(proc) - before[name])
            for name, proc in target.cpu_processes.items()
        }
        return latencies, cpu
    finally:
        transport.close()


def sample_cold_route(target: Target, path: str, samples: int) -> list[float]:
    """Raw latency including a new socket and HTTP connection."""
    latencies = []
    for _ in range(samples):
        transport = target.transport_factory()
        try:
            started = time.perf_counter()
            request(transport, target, path)
            latencies.append((time.perf_counter() - started) * 1000.0)
        finally:
            transport.close()
    return latencies


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--quick", action="store_true", help="fewer samples per route")
    parser.add_argument("--samples", type=int, default=None)
    args = parser.parse_args()

    samples = args.samples if args.samples is not None else (16 if args.quick else 128)
    routes = measured_routes()
    if not routes:
        print(
            "no routes are listed as measured in [benchmark.routes]; every one "
            "is still in the unmeasured debt inventory",
            file=sys.stderr,
        )
        return 1

    service = ServiceInstance()
    service.start()
    gateway = GatewayInstance(service.uds_path)
    gateway.start()

    metrics: dict[str, dict] = {}
    try:
        service_proc = psutil.Process(service.proc.pid)
        gateway_proc = psutil.Process(gateway.proc.pid)
        targets = (
            Target(
                label="service",
                transport_factory=lambda: Transport(socket_path=str(service.uds_path)),
                headers={},
                cpu_processes={"service": service_proc},
            ),
            Target(
                label="gateway",
                transport_factory=lambda: Transport(host="127.0.0.1", port=gateway.port),
                headers={"Authorization": f"Bearer {gateway.token}"},
                cpu_processes={"gateway": gateway_proc, "downstream_service": service_proc},
            ),
        )
        for path in routes:
            for target in targets:
                print(f"{target.label} {path}", file=sys.stderr)
                latencies, cpu = sample_warm_route(target, path, samples)
                cold_latencies = sample_cold_route(target, path, samples)
                metrics[f"{target.label}.{path}.latency_ms"] = {
                    "unit": "milliseconds",
                    "samples": latencies,
                }
                metrics[f"{target.label}.{path}.cold_latency_ms"] = {
                    "unit": "milliseconds",
                    "samples": cold_latencies,
                }
                for process_name, cpu_seconds in cpu.items():
                    suffix = "cpu_s" if process_name == target.label else f"{process_name}_cpu_s"
                    metrics[f"{target.label}.{path}.{suffix}"] = {
                        "unit": "seconds",
                        "samples": [cpu_seconds],
                    }
    finally:
        gateway.stop()
        service.stop()

    json.dump({"metrics": metrics}, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
