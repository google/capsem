#!/usr/bin/env python3
"""Measure HTTP route latency and per-request CPU, direct and via the gateway.

Method/path/cases come from `[benchmark.routes] measured` in `config/gate.toml`. Citadel
requires every registered route to be measured, recorded as debt, or identified
as an internal control route.

Warm latency reuses connections like the UI and gateway pool; cold latency
includes setup. Every response must be successful JSON. Managed lifecycle
POSTs use an idempotently closed tombstone. Prints raw milliseconds plus service
and gateway CPU deltas; `capsem-bench` computes every statistic.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import sys
import threading
import time
import tomllib
from collections.abc import Callable
from contextlib import ExitStack, redirect_stdout
from dataclasses import dataclass
from pathlib import Path

# Match pytest's roots for helpers that import `helpers.*` and `scripts.*`.
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tests"))
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

import psutil
from helpers.benchmark_assets import clone_benchmark_assets
from helpers.constants import ASSETS_DIR
from helpers.http_transport import Transport
from helpers.image_session import image_session
from helpers.process_cpu import process_cpu_seconds
from helpers.service import ServiceInstance
from helpers.stopped_workspace import (
    BODY_URL,
    assert_event_bodies,
    seed_stopped_workspace,
)

from benchmarks.helpers.route_cases import RouteCase, measured_cases
from benchmarks.helpers.route_measurements import route_metrics
from benchmarks.helpers.route_validation import validate_snapshot, validate_wire
from benchmarks.helpers.stream_measurements import service_gateway

ROOT = Path(__file__).resolve().parents[2]
WARMUP = 2
MANAGED_TOKEN = "af" * 32

def route_load_config() -> dict[str, int]:
    config = tomllib.loads((ROOT / "config" / "gate.toml").read_text(encoding="utf-8"))
    return dict(config["benchmark"]["route_load"])


def request_input(path: str) -> tuple[str, bytes | None]:
    """Return the method and body for one repeatable benchmark request."""
    if path.endswith("/claim"):
        return "POST", json.dumps({"ownership_token": MANAGED_TOKEN}).encode()
    if path.endswith("/close"):
        payload = {"ownership_token": MANAGED_TOKEN, "outcome": "cancelled"}
        return "POST", json.dumps(payload).encode()
    return "GET", None


@dataclass(frozen=True)
class Target:
    label: str
    transport_factory: Callable[[], Transport]
    headers: dict[str, str]
    cpu_processes: dict[str, psutil.Process]


def request(transport: Transport, target: Target, path: str) -> bytes:
    """Require one successful JSON response."""
    method, request_body = request_input(path)
    headers = dict(target.headers)
    if request_body is not None:
        headers["Content-Type"] = "application/json"
    status, _, body = transport.request(
        method, path, headers=headers, body=request_body
    )
    if not 200 <= status < 300:
        raise RuntimeError(
            f"{target.label} {path} returned HTTP {status}: {body[:500]!r}"
        )
    try:
        payload = json.loads(body)
    except json.JSONDecodeError as error:
        raise RuntimeError(
            f"{target.label} {path} returned non-JSON: {body[:500]!r}"
        ) from error
    if path == BODY_URL:
        assert_event_bodies(payload)
    return body


def preflight(target: Target, cases: list[RouteCase], live_id: str | None) -> None:
    """Validate real schemas/counters outside all measured windows."""
    transport = target.transport_factory()
    payloads = {}
    try:
        for case in cases:
            path = case.resolve(live_id)
            if request_input(path)[0] != case.method:
                raise ValueError(f"case method differs from its request: {case.metric_key}")
            payloads[case.path] = validate_wire(case, request(transport, target, path), live_id)
        validate_snapshot(payloads)
    finally:
        transport.close()


def sample_warm_route(
    target: Target, path: str, samples: int
) -> tuple[list[float], dict[str, float]]:
    """Raw kept-alive latency and every participating process's CPU."""
    transport = target.transport_factory()
    try:
        for _ in range(WARMUP):
            request(transport, target, path)
        before = {
            name: process_cpu_seconds(proc)
            for name, proc in target.cpu_processes.items()
        }
        latencies = []
        for _ in range(samples):
            started = time.perf_counter()
            request(transport, target, path)
            latencies.append((time.perf_counter() - started) * 1000.0)
        cpu = {
            name: float(process_cpu_seconds(proc) - before[name])
            for name, proc in target.cpu_processes.items()
        }
        return latencies, cpu
    finally:
        transport.close()


def sample_cold_route(target: Target, path: str, samples: int) -> list[float]:
    """Raw latency including a new socket and HTTP connection."""
    latencies = []
    for _ in range(samples):
        transport = target.transport_factory()
        try:
            started = time.perf_counter()
            request(transport, target, path)
            latencies.append((time.perf_counter() - started) * 1000.0)
        finally:
            transport.close()
    return latencies


def sample_concurrent_route(
    target: Target, path: str, samples: int, concurrency: int
) -> tuple[list[float], dict[str, float], float]:
    """Raw latency, CPU and RPS with one kept-alive connection per worker."""
    workers = min(samples, concurrency)
    barrier = threading.Barrier(workers + 1)

    def worker(count: int) -> list[float]:
        transport = target.transport_factory()
        try:
            request(transport, target, path)
            barrier.wait(timeout=30)
            measured = []
            for _ in range(count):
                started = time.perf_counter()
                request(transport, target, path)
                measured.append((time.perf_counter() - started) * 1000.0)
            return measured
        finally:
            transport.close()

    counts = [
        samples // workers + int(index < samples % workers) for index in range(workers)
    ]
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        futures = [executor.submit(worker, count) for count in counts]
        before = {
            name: process_cpu_seconds(proc)
            for name, proc in target.cpu_processes.items()
        }
        started = time.perf_counter()
        barrier.wait(timeout=30)
        latencies = [latency for future in futures for latency in future.result()]
        elapsed = time.perf_counter() - started
    cpu = {
        name: float(process_cpu_seconds(proc) - before[name])
        for name, proc in target.cpu_processes.items()
    }
    return latencies, cpu, samples / elapsed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--quick", action="store_true", help="fewer samples per route")
    parser.add_argument("--samples", type=int, default=None)
    args = parser.parse_args()

    samples = args.samples if args.samples is not None else (16 if args.quick else 128)
    load = route_load_config()
    load_samples = load["quick_requests"] if args.quick else load["requests"]
    concurrency = load["concurrency"]
    cases = measured_cases()
    if not cases:
        print(
            "no routes are listed as measured in [benchmark.routes]; every one "
            "is still in the unmeasured debt inventory",
            file=sys.stderr,
        )
        return 1

    service = ServiceInstance()
    service.assets_dir = clone_benchmark_assets(
        ASSETS_DIR, service.home_dir / "benchmark-assets"
    )

    metrics: dict[str, dict] = {}
    try:
        seed_stopped_workspace(service.tmp_dir, service.assets_dir)
        with redirect_stdout(sys.stderr):
            service.start()
        gateway = service_gateway(service)
        assert service.proc is not None, "service must be running before measurement"
        service_proc = psutil.Process(service.proc.pid)
        gateway_proc = psutil.Process(gateway.pid)
        targets = (
            Target(
                label="service",
                transport_factory=lambda: Transport(socket_path=str(service.uds_path)),
                headers={},
                cpu_processes={"service": service_proc},
            ),
            Target(
                label="gateway",
                transport_factory=lambda: Transport(
                    host="127.0.0.1", port=gateway.port
                ),
                headers={"Authorization": f"Bearer {gateway.token}"},
                cpu_processes={
                    "gateway": gateway_proc,
                    "downstream_service": service_proc,
                },
            ),
        )
        with ExitStack() as fixtures:
            live_id = None
            if any(case.live for case in cases):
                live_id = fixtures.enter_context(
                    image_session(service, service.home_dir / "route-registry", "route-live-owner")
                )
            for target in targets:
                preflight(target, cases, live_id)
            for case in cases:
                concrete_path = case.resolve(live_id)
                path = case.metric_key
                for target in targets:
                    print(f"{target.label} {path}", file=sys.stderr)
                    latencies, cpu = sample_warm_route(target, concrete_path, samples)
                    cold_latencies = sample_cold_route(target, concrete_path, samples)
                    metrics.update(route_metrics(target.label, path, latencies, cold_latencies, cpu))
                    concurrent_latencies, concurrent_cpu, rps = sample_concurrent_route(
                        target, concrete_path, load_samples, concurrency
                    )
                    metrics.update(route_metrics(target.label, path, concurrent_latencies, None, concurrent_cpu, rps))
    finally:
        service.stop()

    json.dump({"metrics": metrics}, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
