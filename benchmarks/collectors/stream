#!/usr/bin/env python3
"""Measure the VM stream through the gateway: keystroke echo, terminal
output, and a streaming command's output.

Every interactive byte a user sees -- the web and TUI terminals, `capsem
doctor`, `capsem run --image` -- crosses `GET /vms/{id}/stream`
(`capsem.stream.v3`): gateway tunnel, service translation to VM-owner IPC,
owner, guest. Nothing measured that path before it replaced the gateway's
terminal relay, so this is the number a later transport change is compared
against.

Prints raw samples on stdout; `capsem-bench` computes every statistic.
"""

from __future__ import annotations

import argparse
import json
import sys
import time
import uuid
from pathlib import Path

# Both, because the test helpers import each other as `helpers.*` and the
# repository scripts as `scripts.*`; a collector run outside pytest has to put
# them on the path itself.
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tests"))
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

import msgpack
import psutil
from helpers.constants import DEFAULT_CPUS, DEFAULT_RAM_MB, EXEC_READY_TIMEOUT
from helpers.service import ServiceInstance, wait_exec_ready
from websockets.sync.client import ClientConnection, connect
from websockets.typing import Subprotocol

from benchmarks.helpers.stream_measurements import Gateway, measure, service_gateway

ROOT = Path(__file__).resolve().parents[2]
WIRE = json.loads((ROOT / "sdk/specification/stream-v3.json").read_text())
SUBPROTOCOL = Subprotocol(WIRE["subprotocol"])
STDOUT, STDERR, STATUS = "stdout", "stderr", "status"
EXEC_BYTES = 100 * 1024 * 1024
TERMINAL_BYTES = 16 * 1024 * 1024
#: Kill-line (Ctrl-U), so the prompt line never grows past a screen.
KILL_LINE = b"\x15"


def control(message: dict) -> bytes:
    return msgpack.packb({"control": message}, use_bin_type=True)


def stdin(data: bytes) -> bytes:
    return msgpack.packb({"stdin": data}, use_bin_type=True)


def open_stream(gateway: Gateway, vm: str, start: dict) -> ClientConnection:
    url = f"ws://127.0.0.1:{gateway.port}/vms/{vm}/stream"
    stream = connect(
        url,
        additional_headers={"Authorization": f"Bearer {gateway.token}"},
        subprotocols=[SUBPROTOCOL],
        max_size=WIRE["max_frame_bytes"],
        open_timeout=30,
    )
    stream.send(control(start))
    status = next_frame(stream, timeout=60)
    if status != (STATUS, {"type": "started"}):
        raise RuntimeError(f"stream did not start: {status}")
    if start["kind"] == "terminal":
        stream.send(control({"type": "focus", "cols": 80, "rows": 24}))
    return stream


def next_frame(stream: ClientConnection, timeout: float) -> tuple[str, object]:
    frame = stream.recv(timeout=timeout)
    if not isinstance(frame, bytes) or not frame:
        raise RuntimeError(f"unexpected stream frame: {frame!r}")
    if len(frame) > WIRE["max_frame_bytes"]:
        raise RuntimeError("stream frame exceeded the shared budget")
    value = msgpack.unpackb(frame, raw=False)
    if not isinstance(value, dict) or len(value) != 1:
        raise RuntimeError("stream frame must contain one named record")
    channel, payload = next(iter(value.items()))
    if channel == STATUS and isinstance(payload, dict):
        return STATUS, payload
    if channel in (STDOUT, STDERR) and isinstance(payload, bytes):
        return channel, payload
    raise RuntimeError(f"unexpected stream record: {channel}")


#: The guest shell's prompt ends in `# ` as root and `$ ` otherwise.
PROMPTS = (b"# ", b"$ ")


def read_until(stream: ClientConnection, marker: bytes | tuple[bytes, ...], timeout: float) -> int:
    """Bytes of output up to and including `marker` (or any of several)."""
    markers = marker if isinstance(marker, tuple) else (marker,)
    deadline = time.monotonic() + timeout
    seen = b""
    total = 0
    while not any(candidate in seen for candidate in markers):
        channel, payload = next_frame(stream, max(deadline - time.monotonic(), 0.001))
        if channel == STATUS:
            if isinstance(payload, dict) and payload.get("type") == "terminal":
                continue
            raise RuntimeError(f"stream ended while waiting for {marker!r}: {payload}")
        assert isinstance(payload, bytes)
        total += len(payload)
        seen = (seen + payload)[-4096:]
    return total


def keystroke_echo(gateway: Gateway, vm: str, keystrokes: int) -> list[float]:
    stream = open_stream(gateway, vm, {"type": "start", "kind": "terminal"})
    try:
        stream.send(stdin(b"\n"))
        read_until(stream, PROMPTS, timeout=30)
        samples = []
        for index in range(keystrokes):
            if index and index % 40 == 0:
                stream.send(stdin(KILL_LINE))
                time.sleep(0.05)
                while True:
                    try:
                        next_frame(stream, timeout=0.05)
                    except TimeoutError:
                        break
            started = time.monotonic()
            stream.send(stdin(b"k"))
            read_until(stream, b"k", timeout=10)
            samples.append((time.monotonic() - started) * 1000)
        stream.send(stdin(KILL_LINE))
        return samples
    finally:
        stream.close()


def terminal_output(gateway: Gateway, vm: str) -> float:
    """Megabits per second of base64 text rendered through the terminal."""
    stream = open_stream(gateway, vm, {"type": "start", "kind": "terminal"})
    try:
        stream.send(stdin(b"\n"))
        read_until(stream, PROMPTS, timeout=30)
        # The typed command echoes `STREAM_$((6*7))`; only its output says 42.
        command = f"head -c {TERMINAL_BYTES} /dev/zero | base64; echo STREAM_$((6*7))\n"
        stream.send(stdin(command.encode()))
        started = time.monotonic()
        received = read_until(stream, b"STREAM_42", timeout=300)
        elapsed = time.monotonic() - started
        return received * 8 / 1_000_000 / elapsed
    finally:
        stream.close()


def resize_echo(gateway: Gateway, vm: str) -> list[float]:
    """SIGWINCH and dimensions must reach the real foreground shell."""
    stream = open_stream(gateway, vm, {"type": "start", "kind": "terminal"})
    try:
        stream.send(
            stdin(
                b"trap 'printf \"BENCH_SIZE_%s_DONE\\n\" \"$(stty size)\"' WINCH; printf 'BENCH_READY_%s_DONE\\n' 42\n"
            )
        )
        read_until(stream, b"BENCH_READY_42_DONE", timeout=30)
        samples = []
        for cols, rows in [(101, 33), (60, 20), (150, 45), (80, 24)] * 5:
            started = time.monotonic()
            stream.send(control({"type": "resize", "cols": cols, "rows": rows}))
            read_until(stream, f"BENCH_SIZE_{rows} {cols}_DONE".encode(), timeout=10)
            samples.append((time.monotonic() - started) * 1000)
        stream.send(stdin(b"trap - WINCH\n"))
        return samples
    finally:
        stream.close()


def exec_output(gateway: Gateway, vm: str) -> tuple[float, float]:
    """Megabits per second and seconds for a 100 MiB streaming command."""
    stream = open_stream(
        gateway, vm, {"type": "start", "kind": "exec", "command": f"head -c {EXEC_BYTES} /dev/zero"}
    )
    try:
        started = time.monotonic()
        received = 0
        while True:
            channel, payload = next_frame(stream, timeout=300)
            if channel == STATUS:
                break
            assert isinstance(payload, bytes)
            received += len(payload)
        elapsed = time.monotonic() - started
        if payload != {"type": "exit", "code": 0, "truncated": False} or received != EXEC_BYTES:
            raise RuntimeError(
                f"exec stream ended {payload} after {received} of {EXEC_BYTES} bytes"
            )
        return received * 8 / 1_000_000 / elapsed, elapsed
    finally:
        stream.close()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--quick", action="store_true", help="one transfer run and fewer keystrokes"
    )
    args = parser.parse_args()
    runs = 1 if args.quick else 3
    keystrokes = 50 if args.quick else 400

    service = ServiceInstance()
    metrics: dict[str, dict] = {}

    def record(key: str, unit: str, value: float | list[float]) -> None:
        samples = value if isinstance(value, list) else [value]
        metrics.setdefault(key, {"unit": unit, "samples": []})["samples"].extend(samples)

    try:
        service.start()
        gateway = service_gateway(service)
        root = psutil.Process(service.proc.pid)
        client = service.client()
        name = f"bench-stream-{uuid.uuid4().hex[:8]}"
        created = client.post(
            "/vms/create", {"name": name, "ram_mb": DEFAULT_RAM_MB, "cpus": DEFAULT_CPUS}
        )
        # The stream route addresses a VM by the id create returns, not its name.
        vm = str((created or {}).get("id") or "")
        if not vm:
            raise RuntimeError(f"create {name} returned {created}")
        if not wait_exec_ready(client, vm, timeout=EXEC_READY_TIMEOUT):
            raise RuntimeError(f"{vm} never became exec-ready")
        measure(metrics, "idle.before", root, lambda: time.sleep(5))
        print(f"stream: {keystrokes} keystrokes", file=sys.stderr)
        echo = measure(
            metrics, "terminal.echo", root, lambda: keystroke_echo(gateway, vm, keystrokes)
        )
        record("terminal.keystroke_echo_ms", "milliseconds", echo)
        resized = measure(metrics, "terminal.resize", root, lambda: resize_echo(gateway, vm))
        record("terminal.resize_echo_ms", "milliseconds", resized)
        for index in range(runs):
            print(f"stream: transfer run {index + 1}/{runs}", file=sys.stderr)
            output = measure(
                metrics, f"terminal.output.{index}", root, lambda: terminal_output(gateway, vm)
            )
            record("terminal.output_mbps", "megabits_per_second", output)
            mbps, seconds = measure(
                metrics, f"exec.output.{index}", root, lambda: exec_output(gateway, vm)
            )
            record("exec.output_mbps", "megabits_per_second", mbps)
            record("exec.output_100mib_seconds", "seconds", seconds)
        measure(metrics, "idle.after", root, lambda: time.sleep(5))
        client.delete(f"/vms/{vm}/delete")
    finally:
        service.stop()

    json.dump({"metrics": metrics}, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
