#!/usr/bin/env python3
"""Measure product v3 streams through the real owned gateway and Rust SDK.

Exec throughput verifies 100 MiB of stdout. Terminal edit projection latency,
output completion and projected bytes replace incomparable v1 raw-PTY metrics.
The product SDK owns framing, authentication and terminal-model decoding.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "tests"))
sys.path.insert(0, str(ROOT))

from helpers.constants import (
    DEFAULT_CPUS,
    DEFAULT_RAM_MB,
    EXEC_READY_TIMEOUT,
    host_bin_root,
)
from helpers.service import ServiceInstance, wait_exec_ready
from helpers.service_gateway import ServiceGateway


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--quick", action="store_true")
    args = parser.parse_args()
    service = ServiceInstance()
    gateway = ServiceGateway(service)
    try:
        service.start()
        gateway.start()
        client = service.client()
        created = client.post("/vms/create", {
            "name": f"bench-stream-{uuid.uuid4().hex[:8]}",
            "ram_mb": DEFAULT_RAM_MB, "cpus": DEFAULT_CPUS,
        })
        vm = str((created or {}).get("id") or "")
        if not vm or not wait_exec_ready(client, vm, timeout=EXEC_READY_TIMEOUT):
            raise RuntimeError("stream benchmark VM did not become ready")
        command = [str(host_bin_root() / "capsem-bench-rs"), "stream-probe",
                   "--gateway-url", gateway.base_url, "--vm-id", vm]
        if args.quick:
            command.append("--quick")
        assert gateway.token is not None
        result = subprocess.run(
            command, env={**os.environ, "CAPSEM_BENCH_GATEWAY_BEARER": gateway.token},
            stdout=subprocess.PIPE, text=True, check=True, timeout=1200,
        )
        sys.stdout.write(result.stdout)
        client.delete(f"/vms/{vm}/delete")
    finally:
        gateway.stop()
        service.stop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
