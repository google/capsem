# check=skip=InvalidDefaultArgInFrom
# BASE is required; the gate supplies the materialized helper's exact image ID.
# Assemble a populated rootfs from one exact dependency image.
# Architecture: {{ arch_name }} ({{ arch.docker_platform }})
# Generated by capsem-builder from profile-derived image inputs.

ARG BASE
FROM ${BASE}

# Install the Capsem MITM CA without resolving another package.
COPY capsem-ca.crt /usr/local/share/ca-certificates/capsem-ca.crt
RUN update-ca-certificates && \
    CERTIFI_BUNDLE=$(python3 -c "import certifi; print(certifi.where())") && \
    cat /usr/local/share/ca-certificates/capsem-ca.crt >> "$CERTIFI_BUNDLE"

{% for binary in guest_binaries %}
COPY {{ binary }} /usr/local/bin/{{ binary }}
RUN chmod 555 /usr/local/bin/{{ binary }}

{% endfor %}
COPY capsem-bashrc /etc/capsem-bashrc
COPY banner.txt /etc/capsem-banner.txt
COPY tips.txt /etc/capsem-tips.txt
{% if profile_root_seed %}
COPY profile-root/ /usr/local/share/capsem/profile-root/
RUN chmod -R go-rwx /usr/local/share/capsem/profile-root
{% endif %}

COPY diagnostics/ /usr/local/lib/capsem-tests/
COPY capsem-doctor /usr/local/bin/capsem-doctor
RUN chmod 755 /usr/local/bin/capsem-doctor && \
    ln -sf capsem-doctor /usr/local/bin/capsem-test

COPY capsem-bench /usr/local/bin/capsem-bench
RUN chmod 555 /usr/local/bin/capsem-bench
COPY capsem_bench/ /usr/local/lib/capsem_bench/

COPY snapshots /usr/local/bin/snapshots
RUN chmod 555 /usr/local/bin/snapshots

# This is an ephemeral sandboxed VM; package-manager writes land in its overlay.
RUN rm -f /usr/lib/python*/EXTERNALLY-MANAGED

# Every dependency is already present. Strip privilege bits, then independently
# prove none remain; an unreadable path or failed chmod must fail the build.
RUN set -eu; \
    find / -xdev -type f \( -perm -4000 -o -perm -2000 \) \
        -exec chmod u-s,g-s {} +; \
    remaining="$(find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -print)"; \
    test -z "$remaining"
RUN rm -rf /root && mkdir -p /root
