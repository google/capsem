# CAPSEM Hardened Kernel Configuration
# Minimal x86_64 for QEMU/KVM virtualization
#
# Applied on top of allnoconfig:
#   make KCONFIG_ALLCONFIG=defconfig.x86_64 allnoconfig
#
# Nothing is enabled unless this file pins it, so every option below is a
# decision with its reason. The build fails if the kernel does not honor a
# pin: a misspelled or renamed symbol, or one whose dependency is not pinned.
#
# Produces a minimal kernel with only VirtIO drivers, no loadable modules,
# air-gapped IP stack (dummy NIC + iptables REDIRECT), and full exploit
# mitigations enabled.

# ==========================================
# 1. CORE x86_64
# ==========================================
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# Initialize large guests' page metadata across their CPUs instead of on
# the boot CPU alone. Sparse memmaps also avoid metadata for the PCI hole.
CONFIG_SPARSEMEM=y
CONFIG_DEFERRED_STRUCT_PAGE_INIT=y

# Start the DMA bounce pool small and grow it only when a device needs it.
# The x86 command line bounds initialization; bouncing stays available.
CONFIG_SWIOTLB=y
CONFIG_SWIOTLB_DYNAMIC=y

# ==========================================
# 2. BOOT ESSENTIALS
# ==========================================
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ==========================================
# 3. PCI & VIRTIO
# ==========================================
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# ==========================================
# 4. SERIAL CONSOLE
# ==========================================
CONFIG_TTY=y
CONFIG_VT=n
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ==========================================
# 5. BLOCK LAYER
# ==========================================
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y

# ==========================================
# 6. FILESYSTEMS
# ==========================================
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y

# ==========================================
# 7. NETWORKING (Unix sockets + vsock + air-gapped IP)
# ==========================================
# Unix domain sockets: required by node, python, git.
# AF_VSOCK: host<->guest communication (PTY, control, SNI proxy).
# IP stack: enabled for air-gapped networking. Guest uses a dummy
# NIC + fake DNS + iptables REDIRECT to funnel all HTTPS through
# a vsock-backed SNI proxy on the host. No real NIC is attached.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=n
CONFIG_IPV6=n

# Dummy NIC (air-gapped: no real NIC, just a local IP for routing)
CONFIG_NETDEVICES=y
CONFIG_DUMMY=y
CONFIG_ETHERNET=n
CONFIG_NET_VENDOR_VIRTIO=n

# Netfilter/iptables-nft: REDIRECT target for transparent proxy
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REDIR=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NF_NAT_REDIRECT=y

# Container egress: one veth pair per workload, its VM end DNAT'ed to the
# same loopback proxies (guest/artifacts/container/launch.py). iptables-nft
# reaches the DNAT target through the xt_nat compat module.
CONFIG_VETH=y
CONFIG_NETFILTER_XT_NAT=y
# A container behind the VM leaves through whichever network cable routes its
# destination, so its source NAT takes that cable's address (MASQUERADE)
# rather than one fixed when the container started.
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NF_NAT_MASQUERADE=y
# Only what a cable delivers to one of the VM's own addresses is handed to
# the container; a packet routed through the VM toward another network is
# not, and meets the cable-to-cable drop.
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Private network cables: capsem-tun opens one tap per network the VM is
# plugged into and pumps its ethernet frames over VSOCK to that network's
# layer-2 switch on the host. The guest kernel does ARP, IP and TCP itself.
CONFIG_TUN=y

# ==========================================
# 8. PROCESS MANAGEMENT
# ==========================================
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_INOTIFY_USER=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FHANDLE=y

# Offline OCI workloads: isolated processes and bounded resource usage.
CONFIG_NAMESPACES=y
# User namespaces let the OCI workload hold its capabilities over a mapped uid
# range instead of over the VM (google/capsem#289).
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y

# ==========================================
# 9. SECURITY HARDENING
# ==========================================
# Expert mode: required so KALLSYMS=n and other hardening options take effect
# (many security-sensitive options are gated behind CONFIG_EXPERT)
CONFIG_EXPERT=y

# Enforce strict memory permissions
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_VMAP_STACK=y

# KASLR
CONFIG_RANDOMIZE_BASE=y

# Stack and buffer protections
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y

# Restrict information leaks
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_KALLSYMS=n
CONFIG_DEBUG_FS=n

# Heap hardening
CONFIG_COMPAT_BRK=n

# Memory hardening
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_HARDENED_USERCOPY=y

# x86-specific mitigations (renamed MITIGATION_* in 6.9)
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y

# Kernel audit subsystem (execve recording)
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# ==========================================
# 10. ATTACK SURFACE REDUCTION
# ==========================================
# No loadable kernel modules -- even root cannot load .ko files
CONFIG_MODULES=n

# No direct physical memory access
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n

# No 32-bit compat (eliminates entire legacy syscall attack surface)
CONFIG_IA32_EMULATION=n

# No kernel hot-swap or suspend
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n
CONFIG_MAGIC_SYSRQ=n

# High-CVE-count subsystems
CONFIG_IO_URING=n
CONFIG_BPF_SYSCALL=n
CONFIG_USERFAULTFD=n

# Seccomp: userspace syscall filtering (defense in depth)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ==========================================
# 11. DISABLED SUBSYSTEMS
# ==========================================
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n
CONFIG_NFS_FS=n
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_SCSI=n
CONFIG_ATA=n

# ==========================================
# 12. WHAT THE KERNEL DEFAULTS USED TO SUPPLY
# ==========================================
# Nothing is on unless pinned here or above. Before the build started from
# allnoconfig, olddefconfig filled ~330 unpinned options with upstream
# defaults: some the guest needs, some hardening, some surface nobody chose.

# --- Needed by the guest ---
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_FILE_LOCKING=y
CONFIG_SWAP=y
CONFIG_RSEQ=y
CONFIG_MEMBARRIER=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_NET_CORE=y
CONFIG_RPS=y
# ss(8) in capsem-init polls TCP, UDP and vsock listeners through sock_diag.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_VSOCKETS_DIAG=y
# The initrd is gzip-compressed.
CONFIG_RD_GZIP=y
CONFIG_FUSE_PASSTHROUGH=y
# /proc/<pid>/smaps and smaps_rollup: workloads read their own memory map.
# Redis refuses to start on arm64 without it (its copy-on-write kernel-bug
# probe reads smaps), and jemalloc and browsers account memory through it.
# pagemap hides physical addresses from unprivileged readers.
CONFIG_PROC_PAGE_MONITOR=y
# Keep file capabilities, ACLs and security labels the rootfs image carries.
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
# ext4 metadata checksums (the system overlay) use the accelerated crc32c.
CONFIG_CRC_OPTIMIZATIONS=y
# The KVM VMM describes vCPUs to Linux only through an ACPI MADT; without
# ACPI the guest boots on CPU0 alone. None of ACPI's device drivers are on.
CONFIG_ACPI=y
CONFIG_X86_X2APIC=y
CONFIG_X86_PAT=y
CONFIG_MTRR=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_SCHED_MC=y
CONFIG_SLUB_CPU_PARTIAL=y
CONFIG_PCI_QUIRKS=y

# --- Upstream hardening and CPU features, kept deliberately ---
# Yama: ptrace only of your own descendants (kernel.yama.ptrace_scope=1 at
# boot), so a package script in a workload cannot attach to the agent CLI
# running beside it as the same user and read its credentials.
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
# TCP SYN cookies (net.ipv4.tcp_syncookies=1 at boot).
CONFIG_SYN_COOKIES=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_SLAB_BUCKETS=y
CONFIG_X86_UMIP=y
CONFIG_X86_KERNEL_IBT=y
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS=y
CONFIG_X86_BUS_LOCK_DETECT=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_ITS=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_TSA=y
CONFIG_MITIGATION_UNRET_ENTRY=y

# --- Surface no sandbox VM needs, off on purpose ---
# Keystroke injection into another terminal; tty line-discipline autoload.
CONFIG_LEGACY_TIOCSTI=n
CONFIG_LDISC_AUTOLOAD=n
CONFIG_LEGACY_PTYS=n
# process_vm_readv/writev: reading another process's memory.
CONFIG_CROSS_MEMORY_ATTACH=n
CONFIG_COREDUMP=n
CONFIG_FTRACE=n
CONFIG_UPROBES=n
# perf_event_open cannot be compiled out: arch/x86/Kconfig selects
# PERF_EVENTS unconditionally. capsem-init sets kernel.perf_event_paranoid=2.
CONFIG_SLUB_DEBUG=n
CONFIG_TIME_NS=n
CONFIG_CACHESTAT_SYSCALL=n
CONFIG_SECRETMEM=n
CONFIG_AF_UNIX_OOB=n
CONFIG_VHOST_MENU=n
CONFIG_EFI=n
CONFIG_PM=n
CONFIG_SUSPEND=n
CONFIG_HID_SUPPORT=n
CONFIG_INPUT=n
CONFIG_SERIO=n
CONFIG_FW_LOADER=n
CONFIG_IOMMU_SUPPORT=n
# Legacy x86 entry points: vsyscall page, per-process LDT, port I/O from
# userspace, 16-bit segments, sgetmask.
CONFIG_X86_VSYSCALL_EMULATION=n
CONFIG_MODIFY_LDT_SYSCALL=n
CONFIG_X86_IOPL_IOPERM=n
CONFIG_X86_16BIT=n
CONFIG_SGETMASK_SYSCALL=n
# Writes to a mounted block device; merged slab caches; overlayfs following
# redirects it did not create.
CONFIG_BLK_DEV_WRITE_MOUNTED=n
CONFIG_BLOCK_LEGACY_AUTOLOAD=n
CONFIG_SLAB_MERGE_DEFAULT=n
CONFIG_OVERLAY_FS_REDIRECT_ALWAYS_FOLLOW=n
