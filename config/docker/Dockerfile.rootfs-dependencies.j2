# check=skip=InvalidDefaultArgInFrom
# BASE is required; the gate passes the exact platform child and owns the sole caller.
# Materialize every third-party rootfs dependency before first-party assembly.
ARG BASE
ARG TRUSTSTORE_IMAGE
FROM ${TRUSTSTORE_IMAGE} AS truststore
FROM ${BASE}

ARG INPUT_IDENTITY
LABEL org.capsem.asset-dependencies.input-key="${INPUT_IDENTITY}"

COPY --from=truststore /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

RUN set -eux; \
    test -f /etc/apt/sources.list.d/debian.sources; \
    cp /etc/apt/sources.list.d/debian.sources /tmp/runtime-debian.sources; \
    rm -f /etc/apt/sources.list.d/*; \
    printf 'deb [check-valid-until=no] %s/%s bookworm main\n' \
        "{{ debian_snapshot_base }}" "{{ debian_snapshot_id }}" \
        > /etc/apt/sources.list; \
    printf 'deb [check-valid-until=no] %s/%s bookworm-updates main\n' \
        "{{ debian_snapshot_base }}" "{{ debian_snapshot_id }}" \
        >> /etc/apt/sources.list; \
    printf 'deb [check-valid-until=no] %s/%s bookworm-security main\n' \
        "{{ debian_security_snapshot_base }}" "{{ debian_snapshot_id }}" \
        >> /etc/apt/sources.list; \
    apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false update

# Split from the source swap above only to keep each body under
# `[boundary.shell_bodies].max_lines`. The command sequence is unchanged, and
# `/tmp/runtime-debian.sources` written above survives into this layer.
RUN set -eux; \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        {{ apt_packages | join(' \\
        ') }} && \
    ln -sf vim.tiny /usr/bin/vim && \
    rm -f /usr/sbin/iptables-legacy /usr/sbin/iptables-legacy-restore /usr/sbin/iptables-legacy-save \
          /usr/sbin/ip6tables-legacy /usr/sbin/ip6tables-legacy-restore /usr/sbin/ip6tables-legacy-save; \
    sed -i 's|URIs: http://|URIs: https://|g' /tmp/runtime-debian.sources; \
    install -m 644 /tmp/runtime-debian.sources /etc/apt/sources.list.d/debian.sources; \
    rm -f /tmp/runtime-debian.sources /etc/apt/sources.list; \
    grep -F 'URIs: https://deb.debian.org' /etc/apt/sources.list.d/debian.sources

RUN set -eux; \
    curl -fsSL '{{ dependency_artifacts.node.url }}' -o /tmp/node.tar.xz; \
    printf '%s  %s\n' '{{ dependency_artifacts.node.sha256 }}' /tmp/node.tar.xz | sha256sum -c -; \
    mkdir -p /usr/local/lib/node; \
    tar -xJf /tmp/node.tar.xz --strip-components=1 -C /usr/local/lib/node; \
    rm -f /tmp/node.tar.xz; \
    for bin in node npm npx; do ln -s "/usr/local/lib/node/bin/$bin" "/usr/local/bin/$bin"; done; \
    test "$(node --version)" = 'v{{ dependency_artifacts.node.version }}'; \
    test "$(npm --version)" = '{{ dependency_artifacts.node.npm_version }}'; \
    npm config set prefix {{ npm_prefix }} --global; \
    test "$(npm config get prefix)" = '{{ npm_prefix }}'

RUN set -eux; \
    curl -fsSL '{{ dependency_artifacts.uv.url }}' -o /tmp/uv.tar.gz; \
    printf '%s  %s\n' '{{ dependency_artifacts.uv.sha256 }}' /tmp/uv.tar.gz | sha256sum -c -; \
    mkdir -p /tmp/uv; \
    tar -xzf /tmp/uv.tar.gz --strip-components=1 -C /tmp/uv; \
    install -m 555 /tmp/uv/uv /usr/local/bin/uv; \
    install -m 555 /tmp/uv/uvx /usr/local/bin/uvx; \
    rm -rf /tmp/uv /tmp/uv.tar.gz; \
    uv_version="$(uv --version)"; \
    set -- $uv_version; \
    test "$1" = uv; \
    test "$2" = '{{ dependency_artifacts.uv.version }}'

{% if npm_packages %}
COPY npm-package.json /tmp/npm/package.json
COPY npm-package-lock.json /tmp/npm/package-lock.json
RUN npm ci --prefix /tmp/npm --ignore-scripts --no-audit --no-fund && \
    mkdir -p {{ npm_prefix }}/bin && \
    mv /tmp/npm/node_modules {{ npm_prefix }}/node_modules && \
    for cli in {{ npm_prefix }}/node_modules/.bin/*; do \
        if test -L "$cli"; then \
            ln -s "../node_modules/.bin/$(basename "$cli")" "{{ npm_prefix }}/bin/$(basename "$cli")"; \
        else \
            test ! -e "$cli"; \
        fi; \
    done && \
    rm -rf /tmp/npm && \
    npm cache clean --force
ENV PATH="{{ npm_prefix }}/bin:$PATH"
{% endif %}

{% if profile_build_script %}
COPY profile-build.sh /tmp/profile-build.sh
RUN chmod 555 /tmp/profile-build.sh && \
    CAPSEM_CLAUDE_URL='{{ dependency_artifacts.claude.url }}' \
    CAPSEM_CLAUDE_SHA256='{{ dependency_artifacts.claude.sha256 }}' \
    CAPSEM_CLAUDE_VERSION='{{ dependency_artifacts.claude.version }}' \
    CAPSEM_OLLAMA_URL='{{ dependency_artifacts.ollama.url }}' \
    CAPSEM_OLLAMA_SHA256='{{ dependency_artifacts.ollama.sha256 }}' \
    CAPSEM_OLLAMA_VERSION='{{ dependency_artifacts.ollama.version }}' \
    /tmp/profile-build.sh && \
    rm -f /tmp/profile-build.sh
{% endif %}

{% if python_packages %}
COPY python-requirements.lock /tmp/python-requirements.lock
RUN uv pip install --system --break-system-packages --require-hashes \
        --requirements /tmp/python-requirements.lock && \
    rm -f /tmp/python-requirements.lock
{% endif %}

RUN rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* && \
    rm -rf /root && mkdir -p /root
