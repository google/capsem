# check=skip=InvalidDefaultArgInFrom
# BASE is required; the gate supplies the materialized helper's exact image ID.
# Compile a hardened, minimal kernel for capsem VM virtualization.
# Architecture: {{ arch_name }} ({{ arch.docker_platform }})
# Produces vmlinuz and initrd.img with busybox + capsem-init.
#
# The kernel is compiled from source, allnoconfig plus a defconfig that:
# - Enables only VirtIO drivers (the only hardware in the VM)
# - Disables loadable modules (CONFIG_MODULES=n)
# - Enables KASLR, stack protector, FORTIFY_SOURCE
#
# Generated by capsem-builder from the runtime image inputs.

ARG BASE
FROM ${BASE} AS build

WORKDIR /usr/src/linux

{% if kernel_patches %}
# Capsem's patches on the pinned source. --fuzz=0 and --forward refuse a patch
# whose context moved or that is already applied, so a kernel bump cannot
# quietly ship without one or with one half-applied.
COPY kernel/patches/ /tmp/kernel-patches/
{% for patch in kernel_patches %}
RUN patch -p1 --forward --fuzz=0 --no-backup-if-mismatch < /tmp/kernel-patches/{{ patch | replace('kernel/patches/', '') }}
{% endfor %}

{% endif %}
# Start from allnoconfig and apply the capsem hardened defconfig on top, so
# nothing is enabled unless the defconfig pins it. olddefconfig would instead
# fill every unpinned option with this kernel version's upstream default.
COPY {{ arch.defconfig }} /tmp/capsem.defconfig
RUN make KCONFIG_ALLCONFIG=/tmp/capsem.defconfig allnoconfig

# Fail when the kernel did not honor a pinned option. Kconfig silently drops a
# misspelled, renamed or unsatisfiable symbol: SLAB_FREELIST_RANDOMIZE (the
# symbol is SLAB_FREELIST_RANDOM) left freelist randomization off while the
# docs listed it as on, and 6.9's MITIGATION_* rename emptied two x86 pins.
# A defconfig with no pins would make the check vacuous, so it fails first.
RUN grep -qE '^CONFIG_[A-Z0-9_]+=' /tmp/capsem.defconfig && \
    unhonored=$(grep -E '^CONFIG_[A-Z0-9_]+=' /tmp/capsem.defconfig | while IFS= read -r line; do \
        name=${line%%=*}; \
        case "$line" in \
            (*=n) if grep -q "^$name=" .config; then echo "$line"; fi ;; \
            (*) if ! grep -qxF "$line" .config; then echo "$line"; fi ;; \
        esac; \
    done) && \
    if [ -n "$unhonored" ]; then \
        echo "defconfig options this kernel did not honor (misspelled, renamed or unmet dependency):" >&2; \
        echo "$unhonored" >&2; \
        exit 1; \
    fi

# Compile kernel
RUN make -j"$(nproc)" {{ arch.kernel_image | replace('arch/' ~ arch_name ~ '/boot/', '') }} && \
    ls -lh {{ arch.kernel_image }}

# ---- Build minimal initrd with busybox + capsem-init ----
COPY capsem-init /tmp/capsem-init
RUN mkdir -p /tmp/initrd/bin /tmp/initrd/sbin /tmp/initrd/dev /tmp/initrd/proc \
             /tmp/initrd/sys /tmp/initrd/newroot /tmp/initrd/tmp /tmp/initrd/conf \
             /tmp/initrd/dev/pts /tmp/initrd/var/log /tmp/initrd/var/tmp && \
    # Busybox-static provides all userspace tools capsem-init needs
    cp /usr/bin/busybox /tmp/initrd/bin/busybox && \
    for cmd in sh mount umount mkdir rmdir sleep ls echo cat chmod cp ln \
               chroot mknod mv rm find grep sed awk; do \
        ln -s busybox /tmp/initrd/bin/$cmd; \
    done && \
    ln -s ../bin/busybox /tmp/initrd/sbin/modprobe && \
    cp /tmp/capsem-init /tmp/initrd/init && \
    chmod 755 /tmp/initrd/init && \
    cd /tmp/initrd && \
    find . | cpio -o -H newc 2>/dev/null | gzip > /tmp/initrd.img && \
    echo "initrd.img: $(ls -lh /tmp/initrd.img | awk '{print $5}')"

# ---- Output stage ----
FROM scratch AS output
COPY --from=build /usr/src/linux/{{ arch.kernel_image }} /vmlinuz
COPY --from=build /tmp/initrd.img /initrd.img
