{
  "name": "capsem-site",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "generate:metrics": "uv run --project ../../build_system --frozen --group docs python -m capsem_builder.docs_metrics --repo ../..",
    "dev": "pnpm run generate:metrics && astro dev --config astro.preview.config.mjs",
    "build": "pnpm run generate:metrics && node --test tools/test-diagrams.mjs tools/test-metrics.mjs && astro build && uv run --project ../../build_system --frozen python tools/check-preview.py dist",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "^0.41.4",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@capsem/diagrams": "file:../diagrams",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "echarts": "6.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "pnpm": {
    "overrides": {
      "undici": "8.12.2",
      "zod": "4.6.7",
      "vite": "8.3.3",
      "nanoid": "^3.3.17",
      "js-yaml": "^4.3.2",
      "dompurify": "^3.4.13",
      "svgo": "^4.1.0",
      "smol-toml": "1.9.0",
      "postcss-selector-parser": "^7.1.6",
      "katex": "^0.18.2"
    },
    "patchedDependencies": {
      "http-cache-semantics@4.3.0": "../../build_system/patches/http-cache-semantics@4.3.0.patch"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "5.9.3"
  }
}
