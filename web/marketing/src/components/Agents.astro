---
import { AGENTS, DOCS } from "../lib/data";
---
<section class="section-space border-t border-line" aria-labelledby="agents-title"><div class="content-shell">
  <div class="prose-brand"><h2 id="agents-title">{AGENTS.title}</h2><p>{AGENTS.description}</p></div>
  <ul class="my-10 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">{AGENTS.names.map((name, i) => <li class="flex items-center gap-3 text-lg font-semibold"><img class="size-7 shrink-0 object-contain" src={`/agents/${["claude", "openai", "gemini", "antigravity", "ollama"][i]}.svg`} alt="" width="28" height="28" loading="lazy" /><span>{name}</span></li>)}</ul>
  <div class="border-t border-line pt-8"><div class="prose-brand mb-6"><h3>{AGENTS.toolsTitle}</h3></div><div class="grid gap-6 md:grid-cols-3">{AGENTS.groups.map((group, i) => <div class={`min-w-0 rounded-2xl border p-6 tool-group tool-group-${i}`}><h4 class="mb-4 flex items-center gap-3 text-sm font-semibold"><span class="font-mono" aria-hidden="true">{["</>", "⌘", "↗"][i]}</span>{group.name}</h4><ul class="flex flex-wrap gap-2">{group.items.map(tool => <li class="rounded-md border bg-paper px-2.5 py-1.5 text-xs">{tool}</li>)}</ul></div>)}</div></div>
  <div class="mt-8 flex flex-col gap-4 border-t border-line pt-6 text-sm text-body sm:flex-row sm:items-center sm:justify-between"><p><strong class="font-semibold text-ink">{AGENTS.custom}.</strong> {AGENTS.detail}</p><a class="text-link" href={DOCS.images}>{AGENTS.link}<span class="text-accent" aria-hidden="true">↗</span></a></div>
</div></section>
