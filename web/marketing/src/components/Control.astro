---
import { CONTROL as C } from "../lib/data";
---
<section class="control-section" aria-labelledby="control-title"><div class="container control-layout">
  <div class="control-copy"><h2 id="control-title">{C.title}</h2><p class="section-description">{C.description}</p><div class="control-links">{C.links.map(link => <a class="text-link" href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>)}</div></div>
  <figure class="activity-figure"><div class="activity-panel"><div class="activity-heading"><strong>{C.titlebar}</strong><span class="status-badge"><i></i>{C.status}</span></div><div class="activity-session"><span class="session-icon" aria-hidden="true">▧</span>{C.session}<span class="session-line"></span></div>
    <table><thead><tr>{C.columns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody>{C.rows.map(row => <tr><td>{row.time}</td><td><strong>{row.title}</strong><small>{row.detail}</small></td><td><span class:list={["decision", {denied:row.denied}]}>{row.status}</span></td></tr>)}</tbody></table>
    <div class="policy-footer"><span class="policy-icon" aria-hidden="true">⌑</span><div><strong>{C.policy}</strong><small>{C.policyDetail}</small></div></div>
  </div><figcaption>{C.caption}</figcaption></figure>
</div></section>
