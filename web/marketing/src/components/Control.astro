---
import { CONTROL as C } from "../lib/data";
---
<section class="control-section section-dark section-space bg-surface text-ink" aria-labelledby="control-title">
  <div class="content-shell">
    <div class="prose-brand mb-10"><h2 id="control-title">{C.title}</h2></div>
    <div class="grid gap-6 lg:grid-cols-3">
      {C.panels.map(panel => <article class="control-card panel">
        <div class="prose-brand"><h3>{panel.title}</h3><p class="lg:min-h-14">{panel.description}</p></div>
        <div class="control-example">
          <div class="example-label">{panel.label}<span aria-hidden="true">↗</span></div>
          {panel.kind === "activity" ? <div class="space-y-3 p-3">
            <article class="rounded-xl border border-line bg-paper p-3"><header class="mb-3 flex flex-wrap items-center gap-2"><strong class="text-xs font-medium">{C.viewer.type}</strong><time class="ml-auto text-[10px] text-muted">{C.viewer.time}</time><span class="w-full font-mono text-[9px] text-muted">{C.viewer.trace}</span></header><div class="mb-3 flex flex-wrap items-center gap-2 text-[10px]"><strong class="font-mono">{C.viewer.tool}</strong><span class="text-muted">{C.viewer.server}</span><span class="decision">{C.viewer.decision}</span></div><div class="space-y-2"><p class="text-[10px] text-muted">{C.viewer.arguments}</p><pre class="overflow-hidden rounded-md bg-surface p-2 font-mono text-[10px] whitespace-pre-wrap break-all text-accent">{C.viewer.request}</pre><p class="text-[10px] text-muted">{C.viewer.response}</p><p class="rounded-md bg-surface p-2 font-mono text-[10px]">{C.viewer.result}</p></div></article>
            <div class="flex items-center justify-between rounded-xl border border-line bg-paper p-3 text-[10px]"><span>{C.viewer.next}</span><span class="text-muted">09:41:04</span></div>
          </div>
          : panel.kind === "rules" ? <div class="divide-y divide-line">{C.rules.map(rule => <div class="p-4"><div class="mb-3 flex items-center gap-2"><span class="text-accent" aria-hidden="true">{rule.icon}</span><strong class="text-xs font-medium">{rule.name}</strong><span class:list={["decision ml-auto", {denied: rule.action === "deny"}]}>{rule.action}</span></div><code class="block break-all font-mono text-[10px] leading-5 text-body">{rule.expression}</code></div>)}</div>
          : <div class="p-3"><pre class="mb-4 overflow-hidden rounded-xl border border-line bg-paper p-3 font-mono text-[10px] leading-6 whitespace-pre-wrap break-all text-body"><code>{C.detection}</code></pre><div class="rounded-xl border border-negative/30 bg-negative/10 p-3"><div class="flex items-center justify-between gap-2 text-xs font-medium text-negative"><span>{C.alert}</span><span class="decision denied">{C.severity}</span></div><p class="mt-2 break-all font-mono text-[9px] text-muted">{C.evidence}</p></div></div>}

        </div>
      </article>)}
    </div>
    <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div class="flex flex-wrap gap-6">{C.links.map(link => <a class="text-link" href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>)}</div><small class="text-xs text-muted">{C.caption}</small></div>
  </div>
</section>
