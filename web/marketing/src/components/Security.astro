---
import { SECURITY as S, DOCS } from "../lib/data";
---
<section class="security-section section-space bg-surface" aria-labelledby="security-title">
  <div class="content-shell">
  <div class="prose-brand"><h2 id="security-title">{S.title}<br /><span class="soft-heading">{S.subtitle}</span></h2><p class="section-description">{S.description}</p></div>
  <div class="security-visual">
    <svg class="security-diagram" viewBox="0 0 1040 390" role="img" aria-labelledby="security-diagram-title">
      <title id="security-diagram-title">{S.diagram}</title>
      <defs><marker id="flow-arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="currentColor" stroke-width="1.3"/></marker></defs>
      <rect class="process-boundary" x="10" y="43" width="296" height="292" rx="20" />
      <text class="diagram-note" x="158" y="321" text-anchor="middle">{S.process}</text>
      <rect class="boundary" x="28" y="61" width="260" height="238" rx="18" />
      <text class="diagram-kicker" x="52" y="91">{S.isolation}</text>
      <rect class="diagram-box" x="47" y="111" width="222" height="128" rx="12" />
      <text class="diagram-title" x="158" y="148" text-anchor="middle">{S.workspace}</text>
      <text class="diagram-body" x="158" y="179" text-anchor="middle">{S.agent}</text>
      <text class="diagram-muted" x="158" y="205" text-anchor="middle">{S.tools}</text>
      <text class="diagram-note" x="158" y="273" text-anchor="middle">{S.airgap}</text>
      <path class="flow" d="M288 175H380" marker-end="url(#flow-arrow)" />
      <rect class="engine-box" x="390" y="95" width="270" height="188" rx="16" />
      <text class="diagram-title" x="525" y="130" text-anchor="middle">{S.engine}</text>
      <path class="engine-divider" d="M411 146H639" />
      {S.controls.map((label, i) => <><circle class="control-dot" cx="417" cy={171+i*35} r="3"/><text class="diagram-body" x="432" y={176+i*35}>{label}</text></>)}
      <path class="credential-flow" d="M525 57V86" marker-end="url(#flow-arrow)" />
      <text class="diagram-body" x="525" y="24" text-anchor="middle">{S.credentials}</text>
      <text class="diagram-muted" x="525" y="46" text-anchor="middle">{S.outside}</text>
      <path class="flow" d="M660 175H744M744 102V248M744 102H788M744 175H788M744 248H788" />
      {S.destinations.map((label, i) => <><rect class="diagram-box" x="790" y={76+i*73} width="222" height="52" rx="10"/><text class="diagram-body" x="901" y={108+i*73} text-anchor="middle">{label}</text></>)}
      <path class="log-flow" d="M525 283V319" />
      <rect class="log-box" x="390" y="319" width="270" height="58" rx="10" />
      <text class="diagram-body" x="525" y="342" text-anchor="middle">{S.logging}</text><text class="diagram-muted" x="525" y="363" text-anchor="middle">{S.trail}</text>
    </svg>
    <div class="security-mobile" aria-hidden="true"><div><small>{S.process}</small><small>{S.isolation}</small><strong>{S.workspace}</strong><span>{S.airgap}</span></div><span class="down-arrow">↓</span><div class="mobile-engine"><strong>{S.engine}</strong>{S.controls.map(label => <span>{label}</span>)}<small>{S.credentials} · {S.outside}</small></div><span class="down-arrow">↓</span><div><strong>{S.destinations.join(" · ")}</strong><span>{S.logging}</span></div></div>
  </div>
  <a class="text-link" href={DOCS.security}>{S.link}<span aria-hidden="true">↗</span></a>
  </div>
</section>
