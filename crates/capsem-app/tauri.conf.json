{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Capsem",
  "version": "0.6.2",
  "identifier": "com.capsem.capsem",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../../web/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Capsem",
        "label": "main",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb"],
    "macOS": {
      "entitlements": "../../build_system/packaging/macos/entitlements.plist",
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "../../web/graphics/tauri/32x32.png",
      "../../web/graphics/tauri/128x128.png",
      "../../web/graphics/tauri/128x128@2x.png",
      "../../web/graphics/tauri/icon.icns",
      "../../web/graphics/tauri/icon.ico"
    ]
  }
}
