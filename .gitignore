.env
*.swp
*.h5
*.egg-info
*.pickle
*.bak
.s.yml
.DS_Store
# Narrow: bare `*_Store` also matches source directories such as
# crates/capsem-process/src/job_store/, and macOS sets core.ignorecase=true,
# so the match is case-insensitive and silent.
*.DS_Store
private/

# Dev setup sentinel (written by just doctor)
.dev-setup
.sprinty/
.sprinty-*/

# Benchmark recordings are generated evidence. Existing tracked files are the
# reviewed baselines; new data must be explicitly force-added to become approved.
benchmarks/**/data_*.json

# Canonical repository-generated output root: Rust builds, VM assets,
# packages, distributions, coverage, benchmarks, and failure evidence.
target/
# Replacement cache root. During the hard cut, every generated output and
# reusable product moves here before the legacy target/ ignore is removed.
/cache/

# Git worktrees
worktrees/

# Tauri
crates/capsem-app/gen/

# Frontend
.astro/
web/app/.astro/
web/app/dist/
web/app/node_modules/
# Generator output -- no runtime code imports it; kept out of the tree to avoid
# churn on every `just _generate-settings` run. See commit 97ab1b5.
web/app/src/lib/mock-settings.generated.ts

# Web project outputs that remain owner-local rather than repository products.
web/marketing/dist/
web/marketing/node_modules/
web/marketing/.astro/
.pnpm-store/

# Leak report log from integration tests
tests/leak-report*.log
tests/leak-attribution*.jsonl
