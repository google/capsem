# pnpm writes atomic metadata scratch beside each configured Node workspace.
# It can disappear between source enumeration and hashing, and is generated
# state rather than an untracked source input.
frontend/_tmp_*
docs/_tmp_*
site/_tmp_*
release-site/_tmp_*
*.pyc
__pycache__/
.ipynb_checkpoints
backup/
venv/
tmp/
env/
.DS_Store
.env
*.swp
*.h5
*.egg-info
dist/*
*.pickle
*.bak
.s.yml
.DS_Store
# Narrow: bare `*_Store` also matches source directories such as
# crates/capsem-process/src/job_store/, and macOS sets core.ignorecase=true,
# so the match is case-insensitive and silent.
*.DS_Store
private/

# Dev setup sentinel (written by just doctor)
.dev-setup
.sprinty/
.sprinty-*/

# Coverage output
coverage/
.coverage
codecov-*.json
codecov-*.xml
*-junit.xml

# Benchmark recordings are generated evidence. Existing tracked files are the
# reviewed baselines; new data must be explicitly force-added to become approved.
benchmarks/**/data_*.json

# Rust
target/

# Git worktrees
worktrees/

# VM assets and the root selector produced by AssetGate. Docker excludes the
# same tree with `**/assets`; neither the bytes nor this generated symlink are
# source inputs, so they must not change the mid-gate source/image identity.
/assets

# Built packages (.pkg, .deb)
packages/

# Tauri
crates/capsem-app/gen/

# Frontend
.astro/
frontend/.astro/
frontend/dist/
frontend/node_modules/
# Generator output -- no runtime code imports it; kept out of the tree to avoid
# churn on every `just _generate-settings` run. See commit 97ab1b5.
frontend/src/lib/mock-settings.generated.ts

# Site
site/dist/
site/node_modules/
site/.astro/
.pnpm-store/

# Leak report log from integration tests
tests/leak-report*.log
tests/leak-attribution*.jsonl
