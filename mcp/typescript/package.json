{
  "name": "@capsem/mcp",
  "version": "0.7.1",
  "description": "Capsem MCP server over the authenticated gateway SDK",
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "git+https://github.com/google/capsem.git", "directory": "mcp/typescript"},
  "type": "module",
  "engines": {"node": ">=20"},
  "bin": {"capsem-mcp": "./dist/cli.js"},
  "files": ["dist", "README.md"],
  "pnpm": {"overrides": {"body-parser": "2.4.0", "hono": "4.13.11", "ip-address": "10.7.4", "vite": "8.3.3"}},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run build && pnpm run test:mcp",
    "test:mcp": "vitest run --coverage",
    "prewarm:packed": "node tools/prewarm-package.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@capsem/sdk": "workspace:0.7.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
