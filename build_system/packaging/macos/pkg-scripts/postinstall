#!/bin/bash
# postinstall -- Runs after macOS .pkg installation.
#
# The .pkg installs files to /usr/local/share/capsem/. This script copies
# them to the user's ~/.capsem/ directory, codesigns for Virtualization.framework,
# registers the LaunchAgent, and waits for service readiness.
#
# PackageKit runs postinstall as root. Headless callers provide a secure
# install-user request; interactive installs fall back to SUDO_USER, USER,
# then the console owner.
set -euo pipefail
source "$(dirname "$0")/install-diagnostics"
source "$(dirname "$0")/install-user"
source "$(dirname "$0")/install-manifest"

USER=$(capsem_resolve_install_user "/var/run/capsem/install-user")
CAPSEM_INSTALL_MANIFEST_REQUEST="/var/run/capsem/install-manifest"
CAPSEM_INSTALL_MANIFEST_PAYLOAD="/var/run/capsem/install-manifest.json"
# Cleared on success, at the bottom -- not from an EXIT trap. A failing
# postinst that consumed the request left the immediately following
# `apt-get install -f` with none, so the retry of the *same* install silently
# hydrated from the public channel: the error then named production while the
# real failure was local, and a retry that happened to succeed would have
# installed something nobody asked for. The writer clears it too, on every
# path, so leaving it here cannot strand one.

PKG_SHARE="/usr/local/share/capsem"
USER_HOME=$(eval echo "~$USER")
CAPSEM_DIR="$USER_HOME/.capsem"
INSTALL_LOG="$CAPSEM_DIR/logs/install.log"
su "$USER" -c '/bin/bash -s' <<'CAPSEM_USER'
set -euo pipefail
mkdir -p "$HOME/.capsem/logs"
CAPSEM_USER
# HOME expands in the installing user's shell.
# shellcheck disable=SC2016
INSTALL_RUN_ID=$(su "$USER" -c 'cat "$HOME/.capsem/logs/install-current-run"' 2>/dev/null || true)
if [[ ! "$INSTALL_RUN_ID" =~ ^[0-9]{8}T[0-9]{6}Z$ ]]; then
    INSTALL_RUN_ID=$(date -u '+%Y%m%dT%H%M%SZ')
fi
INSTALL_RUN_LOG="$CAPSEM_DIR/logs/install-$INSTALL_RUN_ID.log"
CAPSEM_INSTALL_PHASE="initialize_log"
CAPSEM_INSTALL_RUN_LOG="$INSTALL_RUN_LOG"
CAPSEM_INSTALL_FAILURE_FILE="$CAPSEM_DIR/logs/install-failure.txt"
CAPSEM_INSTALL_USER="$USER"
CAPSEM_INSTALL_FAILURE_AS_USER=1
capsem_install_enable_failure_trap
su "$USER" -c "CAPSEM_INSTALL_RUN_ID=$INSTALL_RUN_ID /bin/bash -s" <<'CAPSEM_USER'
set -euo pipefail
touch "$HOME/.capsem/logs/install.log" "$HOME/.capsem/logs/install-$CAPSEM_INSTALL_RUN_ID.log"
ln -sf "install-$CAPSEM_INSTALL_RUN_ID.log" "$HOME/.capsem/logs/install-latest.log"
rm -f "$HOME/.capsem/logs/install-failure.txt"
CAPSEM_USER
exec > >(su "$USER" -c "tee -a \"\$HOME/.capsem/logs/install.log\" \"\$HOME/.capsem/logs/install-$INSTALL_RUN_ID.log\"") 2>&1
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=start user=$USER pkg_share=$PKG_SHARE install_run_id=$INSTALL_RUN_ID install_run_log=$INSTALL_RUN_LOG"

# Create user-level directory layout. Remove stale asset symlinks from dev
# installs so this package never writes through to an old worktree.
CAPSEM_INSTALL_PHASE="prepare_layout"
su "$USER" -c '/bin/bash -s' <<'CAPSEM_USER'
set -euo pipefail
CAPSEM_DIR="$HOME/.capsem"
rm -rf "$CAPSEM_DIR"/bin.backup*
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=retired_binary_backups_removed"
retired_user_config="user"".toml"
rm -f "$CAPSEM_DIR/$retired_user_config" "$CAPSEM_DIR/service.toml"
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=retired_config_removed"
mkdir -p "$CAPSEM_DIR/bin" "$CAPSEM_DIR/run"
rm -rf "$CAPSEM_DIR/bin/capsem-admin-python"
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=retired_python_admin_bundle_removed"
if [ -L "$CAPSEM_DIR/assets" ]; then
    rm "$CAPSEM_DIR/assets"
elif [ -e "$CAPSEM_DIR/assets" ] && [ ! -d "$CAPSEM_DIR/assets" ]; then
    rm -f "$CAPSEM_DIR/assets"
fi
mkdir -p "$CAPSEM_DIR/assets"
rm -rf "$CAPSEM_DIR"/update-check*
rm -f "$CAPSEM_DIR/assets"/manifest-*origin*.json
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=obsolete_manifest_state_removed"
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=layout_ready capsem_dir=$CAPSEM_DIR"
CAPSEM_USER

# Copy companion binaries from pkg payload
CAPSEM_INSTALL_PHASE="copy_binaries"
su "$USER" -c '/bin/bash -s' <<'CAPSEM_USER'
set -euo pipefail
PKG_SHARE="/usr/local/share/capsem"
CAPSEM_DIR="$HOME/.capsem"
for bin in capsem capsem-service capsem-process capsem-ledger capsem-proxy capsem-tui capsem-router capsem-mcp-aggregator capsem-mcp-builtin capsem-gateway capsem-tray capsem-admin capsem-mock-server capsem-bench-rs; do
    src="$PKG_SHARE/bin/$bin"
    if [ ! -f "$src" ]; then
        echo "capsem: packaged binary missing: $src" >&2
        echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=binary_missing bin=$bin src=$src"
        exit 1
    fi
    cp "$src" "$CAPSEM_DIR/bin/$bin"
    chmod 755 "$CAPSEM_DIR/bin/$bin"
done
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=binaries_copied"
CAPSEM_USER

CAPSEM_INSTALL_PHASE="codesign_binaries"
su "$USER" -c '/bin/bash -s' <<'CAPSEM_USER'
set -euo pipefail
PKG_SHARE="/usr/local/share/capsem"
CAPSEM_DIR="$HOME/.capsem"
codesign_identifier_for_bin() {
    case "$(basename "$1")" in
        capsem) echo "org.capsem.cli" ;;
        capsem-service) echo "org.capsem.service" ;;
        capsem-process) echo "org.capsem.process" ;;
        capsem-ledger) echo "org.capsem.ledger" ;;
        capsem-proxy) echo "org.capsem.proxy" ;;
        capsem-tui) echo "org.capsem.tui" ;;
        capsem-router) echo "org.capsem.router" ;;
        capsem-mcp-aggregator) echo "org.capsem.mcp.aggregator" ;;
        capsem-mcp-builtin) echo "org.capsem.mcp.builtin" ;;
        capsem-gateway) echo "org.capsem.gateway" ;;
        capsem-tray) echo "org.capsem.tray" ;;
        capsem-admin) echo "org.capsem.admin" ;;
        capsem-mock-server) echo "org.capsem.mock-server" ;;
        capsem-bench-rs) echo "org.capsem.bench" ;;
        *) return 1 ;;
    esac
}

# Preserve production Developer ID signatures. Development packages may carry
# unsigned binaries; confined workers receive no VM entitlement.
if [ -f "$PKG_SHARE/entitlements.plist" ]; then
    for bin in "$CAPSEM_DIR/bin"/capsem*; do
        identifier=$(codesign_identifier_for_bin "$bin" || true)
        if [ -n "$identifier" ]; then
            if codesign --verify --strict "$bin" 2>/dev/null; then
                echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=binary_signature_preserved bin=$(basename "$bin")"
            else
                case "$(basename "$bin")" in
                    capsem-router|capsem-ledger|capsem-proxy)
                        codesign --sign - --identifier "$identifier" --force "$bin"
                        ;;
                    *)
                        codesign --sign - --identifier "$identifier" --entitlements "$PKG_SHARE/entitlements.plist" --force "$bin"
                        ;;
                esac
                echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=binary_signed_ad_hoc bin=$(basename "$bin")"
            fi
        fi
    done
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=binary_signatures_ready identity_prefix=org.capsem"
fi
CAPSEM_USER

CAPSEM_INSTALL_PHASE="install_manifest_provenance"
if [ ! -f "$PKG_SHARE/assets/manifest-metadata.json" ]; then
    echo "capsem: packaged manifest-metadata.json missing" >&2
    exit 1
fi
su "$USER" -c '/bin/bash -s' <<'CAPSEM_USER'
set -euo pipefail
PKG_SHARE="/usr/local/share/capsem"
CAPSEM_DIR="$HOME/.capsem"
install -m 0644 "$PKG_SHARE/assets/manifest-metadata.json" "$CAPSEM_DIR/assets/manifest-metadata.json"
CAPSEM_USER
MANIFEST_METADATA=$(tr '\n' ' ' < "$PKG_SHARE/assets/manifest-metadata.json")
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=manifest_metadata $MANIFEST_METADATA"
MANIFEST_SOURCE=$(sed -n 's/.*"manifest_url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PKG_SHARE/assets/manifest-metadata.json" | head -n 1)
if [ -z "$MANIFEST_SOURCE" ]; then
    echo "capsem: packaged manifest-metadata.json has no manifest_url" >&2
    exit 1
fi
MANIFEST_SELECTION=$(capsem_resolve_install_manifest \
    "$MANIFEST_SOURCE" \
    "$CAPSEM_INSTALL_MANIFEST_REQUEST")
MANIFEST_SOURCE=$(printf '%s\n' "$MANIFEST_SELECTION" | sed -n '1p')
MANIFEST_PAYLOAD=$(printf '%s\n' "$MANIFEST_SELECTION" | sed -n '2p')
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=manifest_source source=$MANIFEST_SOURCE"

CAPSEM_INSTALL_PHASE="install_manifest"
if [ -x "$CAPSEM_DIR/bin/capsem" ]; then
    MANIFEST_INPUT=""
    MANIFEST_INPUT_TEMP=""
    if [[ "$MANIFEST_SOURCE" == file://* && -z "$MANIFEST_PAYLOAD" ]]; then
        MANIFEST_MODE=local
    else
        MANIFEST_MODE=stream
        install -d -m 0700 /var/run/capsem
        MANIFEST_INPUT_TEMP=$(mktemp /var/run/capsem/install-manifest-input.XXXXXX)
        MANIFEST_INPUT=$(capsem_materialize_install_manifest_input "$MANIFEST_SOURCE" "$MANIFEST_PAYLOAD" "$MANIFEST_INPUT_TEMP")
    fi
    USER_MANIFEST_CODE=$(capsem_user_manifest_command)
    if ! { printf '%s\n%s\n' "$MANIFEST_SOURCE" "$MANIFEST_MODE"; [ -z "$MANIFEST_INPUT" ] || cat "$MANIFEST_INPUT"; } \
        | su "$USER" -c "/bin/bash -c '$USER_MANIFEST_CODE'"; then
        [ -z "$MANIFEST_INPUT_TEMP" ] || rm -f "$MANIFEST_INPUT_TEMP"
        echo "capsem: manifest installation failed" >&2
        echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=manifest_install_failed"
        exit 1
    fi
    [ -z "$MANIFEST_INPUT_TEMP" ] || rm -f "$MANIFEST_INPUT_TEMP"
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=manifest_installed"
fi

case "$MANIFEST_SELECTION" in
    *$'\n'*)
        echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=update_status_refresh_skipped source=$MANIFEST_SOURCE reason=preverified_install_payload"
        ;;
    http://*|https://*)
        CAPSEM_INSTALL_PHASE="refresh_update_status"
        if ! su "$USER" -c "CAPSEM_HOME=\"$CAPSEM_DIR\" CAPSEM_RUN_DIR=\"$CAPSEM_DIR/run\" \"$CAPSEM_DIR/bin/capsem\" update --check"; then
            echo "capsem: update status refresh failed" >&2
            echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=update_status_refresh_failed source=$MANIFEST_SOURCE"
            exit 1
        fi
        echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=update_status_refreshed source=$MANIFEST_SOURCE"
        ;;
    *)
        echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=update_status_refresh_skipped source=$MANIFEST_SOURCE reason=non_http_manifest"
        ;;
esac

# Add ~/.capsem/bin to PATH in shell profile
CAPSEM_INSTALL_PHASE="configure_shell"
# HOME must expand in the target user's shell.
# shellcheck disable=SC2016
su "$USER" -c '
set -eu
for PROFILE in "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.bashrc"; do
    if [ -f "$PROFILE" ]; then
        if ! grep -qF ".capsem/bin" "$PROFILE"; then
            printf "%s\n" "export PATH=\"\$HOME/.capsem/bin:\$PATH\"" >> "$PROFILE"
        fi
        break
    fi
done

FISH_CONFIG="$HOME/.config/fish/config.fish"
mkdir -p "$(dirname "$FISH_CONFIG")"
touch "$FISH_CONFIG"
if ! grep -qF "fish_add_path --path \"\$HOME/.capsem/bin\"" "$FISH_CONFIG"; then
    printf "%s\n" "fish_add_path --path \"\$HOME/.capsem/bin\"" >> "$FISH_CONFIG"
fi
'

# Register LaunchAgent as the installing user. Do not hide readiness: the GUI
# should only launch after the service and gateway are ready. Asset readiness is
# exposed through the service/UI rather than a setup side effect.
CAPSEM_INSTALL_PHASE="register_service"
if ! su "$USER" -c "$CAPSEM_DIR/bin/capsem install" 2>/dev/null; then
    echo "capsem: service registration failed" >&2
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=service_registration_failed"
    exit 1
fi
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=service_registered"

READY=0
STATUS_OUTPUT=""
CAPSEM_INSTALL_PHASE="wait_for_service"
for attempt in $(seq 1 30); do
    STATUS_OUTPUT=$(su "$USER" -c "$CAPSEM_DIR/bin/capsem status" 2>/dev/null || true)
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=readiness_poll attempt=$attempt"
    if echo "$STATUS_OUTPUT" | grep -q "Service:   ok" \
        && echo "$STATUS_OUTPUT" | grep -q "Gateway:   ok"; then
        READY=1
        break
    fi
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=service_not_ready_yet attempt=$attempt"
    sleep 1
done

# --- GUI detection and app launch ---
# Open the desktop app only when the daemon and gateway are ready. Runtime
# asset readiness is reported by the service and UI, not gated here.
CAPSEM_INSTALL_PHASE="launch_app"
if [ "$READY" -eq 1 ] && [ "$(uname)" = "Darwin" ] && [ -d "/Applications/Capsem.app" ]; then
    # Kill stale pre-install GUI instances so Installer.app cannot leave a
    # skipped or cached frontend talking to the freshly installed daemon.
    pkill -x capsem-app 2>/dev/null || true
    su "$USER" -c "open /Applications/Capsem.app" 2>/dev/null || true
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=gui_opened"
elif [ "$READY" -eq 1 ] && [ "$(uname)" = "Linux" ]; then
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        if command -v capsem-app >/dev/null 2>&1; then
            su "$USER" -c "capsem-app &" 2>/dev/null || true
        fi
    fi
    # headless Linux: service is registered; UI launch is not available.
elif [ "$READY" -ne 1 ]; then
    echo "capsem: service is not ready after install" >&2
    echo "$STATUS_OUTPUT" >&2
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=service_not_ready"
    exit 1
fi

echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=postinstall event=complete"
CAPSEM_INSTALL_PHASE="complete"
rm -f "$CAPSEM_INSTALL_MANIFEST_REQUEST" "$CAPSEM_INSTALL_MANIFEST_PAYLOAD"
exit 0
