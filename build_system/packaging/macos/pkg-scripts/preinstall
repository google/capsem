#!/bin/bash
# preinstall -- Removes the previous package-owned Capsem payload before
# installing the new one. Downgrades and same-version reinstalls are valid:
# PackageKit version ordering must not decide whether the app is replaced.
set -euo pipefail
source "$(dirname "$0")/install-diagnostics"
source "$(dirname "$0")/install-user"
source "$(dirname "$0")/retire-cohort"
source "$(dirname "$0")/preinstall-ledger"

USER=$(capsem_resolve_install_user "/var/run/capsem/install-user")

INSTALL_RUN_ID=$(date -u '+%Y%m%dT%H%M%SZ')
install -d -m 0700 /var/run/capsem
INSTALL_LOG="/var/run/capsem/install.log"
INSTALL_RUN_LOG="/var/run/capsem/install-$INSTALL_RUN_ID.log"
CAPSEM_DIR="/var/run/capsem"
if [ -n "${USER:-}" ] && [ "$USER" != "root" ]; then
    USER_HOME=$(eval echo "~$USER")
    CAPSEM_DIR="$USER_HOME/.capsem"
    su "$USER" -c "CAPSEM_INSTALL_RUN_ID=$INSTALL_RUN_ID /bin/bash -s" <<'CAPSEM_USER'
set -euo pipefail
mkdir -p "$HOME/.capsem/logs"
touch "$HOME/.capsem/logs/install.log" "$HOME/.capsem/logs/install-$CAPSEM_INSTALL_RUN_ID.log"
printf '%s\n' "$CAPSEM_INSTALL_RUN_ID" > "$HOME/.capsem/logs/install-current-run"
ln -sf "install-$CAPSEM_INSTALL_RUN_ID.log" "$HOME/.capsem/logs/install-latest.log"
CAPSEM_USER
    INSTALL_LOG="$CAPSEM_DIR/logs/install.log"
    INSTALL_RUN_LOG="$CAPSEM_DIR/logs/install-$INSTALL_RUN_ID.log"
fi
CAPSEM_INSTALL_PHASE="initialize_log"
CAPSEM_INSTALL_RUN_LOG="$INSTALL_RUN_LOG"
CAPSEM_INSTALL_FAILURE_FILE="$CAPSEM_DIR/logs/install-failure.txt"
CAPSEM_INSTALL_USER="${USER:-}"
CAPSEM_INSTALL_FAILURE_AS_USER=1
capsem_install_enable_failure_trap
if [ -n "${USER:-}" ] && [ "$USER" != "root" ]; then
    # HOME expands after su changes identity.
    # shellcheck disable=SC2016
    su "$USER" -c 'rm -f "$HOME/.capsem/logs/install-failure.txt"'
    exec > >(su "$USER" -c "tee -a \"\$HOME/.capsem/logs/install.log\" \"\$HOME/.capsem/logs/install-$INSTALL_RUN_ID.log\"") 2>&1
else
    rm -f "$CAPSEM_INSTALL_FAILURE_FILE"
    exec > >(tee -a "$INSTALL_LOG" "$INSTALL_RUN_LOG") 2>&1
fi
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=preinstall event=start user=${USER:-unknown} install_run_id=$INSTALL_RUN_ID install_run_log=$INSTALL_RUN_LOG"

CAPSEM_INSTALL_PHASE="admit_candidate_ledger"
if ! declare -F capsem_run_preinstall_ledger_admission >/dev/null; then
    echo 'capsem: package is missing its candidate preinstall ledger resource' >&2
    exit 1
fi
capsem_run_preinstall_ledger_admission "$USER"

CAPSEM_INSTALL_PHASE="stop_existing_install"
if [ -n "${USER:-}" ] && [ "$USER" != "root" ]; then
    PLIST="$USER_HOME/Library/LaunchAgents/com.capsem.service.plist"
    capsem_stop_launch_agent "gui/$(id -u "$USER")" "$PLIST"
    capsem_retire_native_cohort "$CAPSEM_DIR" "$(id -u "$USER")" "$USER"
fi

# The first check cannot exclude state created by a still-running old service.
# Repeat the same signed candidate after exact retirement, before payload removal.
CAPSEM_INSTALL_PHASE="admit_drained_ledger"
capsem_run_preinstall_ledger_admission "$USER"

CAPSEM_INSTALL_PHASE="remove_app_payload"
if [ -n "${USER_HOME:-}" ] && [ "$USER_HOME" != "/" ]; then
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=preinstall event=remove_user_app_payload path=$USER_HOME/Applications/Capsem.app"
    # shellcheck disable=SC2016
    su "$USER" -c 'rm -rf "$HOME/Applications/Capsem.app"'
fi

CAPSEM_INSTALL_PHASE="remove_package_payload"
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=preinstall event=remove_old_payload"
rm -rf /Applications/Capsem.app
rm -rf /usr/local/share/capsem

echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') phase=preinstall event=complete"
CAPSEM_INSTALL_PHASE="complete"
exit 0
