#!/bin/bash
# Retire only native helpers proven to belong to the installed Capsem cohort.
# Full command paths own ordinary helpers. The service and gateway PID files
# remain authoritative when macOS reports only a basename for an old process.

capsem_pidfile_owns_process() {
    local capsem_dir="$1"
    local name="$2"
    local pid="$3"
    local pidfile=""
    case "$name" in
        capsem-service) pidfile="$capsem_dir/run/service.pid" ;;
        capsem-gateway) pidfile="$capsem_dir/run/gateway.pid" ;;
        *) return 1 ;;
    esac
    [ -f "$pidfile" ] || return 1
    local recorded
    recorded=$(sed -n '1p' "$pidfile" 2>/dev/null || true)
    [ "$recorded" = "$pid" ]
}

capsem_process_is_package_owned() {
    local capsem_dir="$1"
    local target_uid="$2"
    local name="$3"
    local pid="$4"
    case "$pid" in
        ""|*[!0-9]*) return 1 ;;
    esac

    local actual_uid executable process_name
    actual_uid=$(ps -p "$pid" -o uid= 2>/dev/null | tr -d '[:space:]')
    [ "$actual_uid" = "$target_uid" ] || return 1
    if [ -L "/proc/$pid/exe" ]; then
        executable=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
        executable=${executable% (deleted)}
    else
        executable=$(ps -p "$pid" -o comm= 2>/dev/null | sed 's/[[:space:]]*$//')
    fi
    process_name=${executable##*/}
    [ "$process_name" = "$name" ] || return 1
    case "$executable" in
        "$capsem_dir/bin/$name"|/usr/bin/"$name")
            return 0
            ;;
    esac
    if [ "$name" = "capsem-app" ]; then
        case "$executable" in
            /Applications/Capsem.app/Contents/MacOS/capsem-app) return 0 ;;
        esac
        case "$capsem_dir" in
            */.capsem)
                [ "$executable" != "${capsem_dir%/.capsem}/Applications/Capsem.app/Contents/MacOS/capsem-app" ] || return 0
                ;;
        esac
    fi
    capsem_pidfile_owns_process "$capsem_dir" "$name" "$pid"
}

capsem_retire_native_cohort() {
    # Retire the historical router executable when upgrading an older cohort.
    capsem_retire_named_cohort "$1" "$2" "${3:-}" capsem-service capsem-gateway capsem-tray capsem-process capsem-ledger capsem-proxy capsem-router capsem-port-router capsem-mcp-aggregator capsem-mcp-builtin capsem-app
}

capsem_retire_installed_app() {
    # Postinstall must not retire the freshly started service/helper cohort.
    capsem_retire_named_cohort "$1" "$2" "$3" capsem-app
}

capsem_signal_as_install_user() {
    local target_uid="$1" target_user="$2" kill_command="$3" pid="$4"
    if [ "$(id -u)" = "$target_uid" ]; then
        "$kill_command" -9 "$pid"
        return $?
    fi
    # Inspection cannot fence PID reuse. Actual signal authority belongs to
    # the selected account, so a reused foreign-user PID remains protected.
    case "$(uname -s)" in
        Darwin) su "$target_user" -c 'exec "$1" -9 "$2"' capsem-retire "$kill_command" "$pid" ;;
        Linux) /usr/sbin/runuser -u "$target_user" -- "$kill_command" -9 "$pid" ;;
        *) echo "capsem: unsupported selected-user signal adapter" >&2; return 1 ;;
    esac
}

capsem_retire_named_cohort() {
    local capsem_dir="$1" target_uid="$2" target_user="$3"
    shift 3
    case "$target_uid" in ""|0|*[!0-9]*) echo "capsem: retirement requires a non-root UID" >&2; return 1 ;; esac
    if [ -n "$target_user" ]; then
        [ "$(id -u "$target_user")" = "$target_uid" ] || { echo "capsem: retirement user/UID mismatch" >&2; return 1; }
    elif [ "$(id -u)" != "$target_uid" ]; then
        echo "capsem: privileged retirement requires the selected user" >&2
        return 1
    fi
    local kill_command="${CAPSEM_INSTALL_KILL:-/bin/kill}"
    local killed=""
    local name pid
    for name in "$@"; do
        for pid in $(pgrep -u "$target_uid" -f "$name" 2>/dev/null || true); do
            if capsem_process_is_package_owned "$capsem_dir" "$target_uid" "$name" "$pid"; then
                capsem_signal_as_install_user "$target_uid" "$target_user" "$kill_command" "$pid" || return 1
                killed="$killed $pid"
                echo "retired native helper pid=$pid name=$name"
            fi
        done
    done

    local survivor
    for _ in $(seq 1 50); do
        survivor=""
        for pid in $killed; do
            if ps -p "$pid" >/dev/null 2>&1; then
                survivor="$survivor $pid"
            fi
        done
        [ -n "$survivor" ] || return 0
        sleep 0.1
    done
    echo "capsem: native helper cohort did not stop:$survivor" >&2
    return 1
}

# Confirm manager quiescence, including ordinary already-stopped reinstalls.
# Never interpret a generic query failure as absence of the target service.
capsem_stop_launch_agent() {
    local domain="$1" plist="$2" uid="${1#gui/}" state status expected
    case "$uid" in ''|0|*[!0-9]*) return 1 ;; esac
    [ "$domain" = "gui/$uid" ] || return 1
    /bin/launchctl bootout "$domain/com.capsem.service" 2>/dev/null || {
        if [ -f "$plist" ]; then /bin/launchctl unload "$plist" 2>/dev/null || true; fi
    }
    if state=$(LC_ALL=C /bin/launchctl print "$domain/com.capsem.service" 2>&1 >/dev/null); then
        echo 'capsem: selected LaunchAgent remains loaded' >&2
        return 1
    else
        status=$?
    fi
    expected=$(printf 'Bad request.\nCould not find service "com.capsem.service" in domain for user gui: %s' "$uid")
    if [ "$status" -ne 113 ] || [ "$state" != "$expected" ]; then
        echo 'capsem: cannot verify selected LaunchAgent absence' >&2
        return 1
    fi
}

capsem_stop_systemd_service() {
    local target_user="$1" xdg="$2" state line count=0 load="" active="" sub=""
    su "$target_user" -c 'export LC_ALL=C XDG_RUNTIME_DIR="$1"; exec systemctl --user stop capsem.service' \
        capsem-quiesce "$xdg" 2>/dev/null || true
    state=$(su "$target_user" -c 'export LC_ALL=C XDG_RUNTIME_DIR="$1"; exec systemctl --user show --property=LoadState --property=ActiveState --property=SubState capsem.service' \
        capsem-quiesce "$xdg") || { echo 'capsem: cannot verify selected systemd service state' >&2; return 1; }
    while IFS= read -r line; do
        count=$((count + 1))
        case "$line" in
            LoadState=*) [ -z "$load" ] || return 1; load=${line#LoadState=} ;;
            ActiveState=*) [ -z "$active" ] || return 1; active=${line#ActiveState=} ;;
            SubState=*) [ -z "$sub" ] || return 1; sub=${line#SubState=} ;;
            *) return 1 ;;
        esac
    done <<< "$state"
    [ "$count" -eq 3 ] || return 1
    case "$load" in loaded|not-found|masked) ;; *) return 1 ;; esac
    [ "$active" = inactive ] && [ "$sub" = dead ] || {
        echo 'capsem: selected systemd service is not inactive' >&2
        return 1
    }
}
