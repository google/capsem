# The Linux parity lane's dependencies, resolved once and never at run time.
#
# The lane used to carry four named Docker volumes -- cargo registry, cargo
# git, rustup, and an 11 GB target -- which persisted between runs. That is
# what made a warm machine and a cold CI runner disagree about the same
# commit, and it is why `just test` could pass locally on state no clean
# checkout has.
#
# Everything those volumes held is baked here instead, keyed by the lockfiles
# that determine it. A dependency change produces a different tag; an
# unchanged tree reuses the image. `just warm` builds it with network, and the
# lane itself then runs with `--network none`, which is what proves this file
# is complete rather than merely believed to be.
ARG BASE=capsem-host-builder:latest
FROM ${BASE}

# Only the files that decide the dependency set. Copying the whole tree here
# would rebuild this image on every source edit and defeat the caching it
# exists for.
COPY Cargo.toml Cargo.lock rust-toolchain.toml /src/
COPY crates /src/crates
COPY third_party/rust /src/third_party/rust
# Workspace crates embed or inspect files from these repository roots at
# compile time. Copy every such root before prewarming so adding another
# fixture under an existing root cannot silently turn the warm build cold.
COPY config /src/config
COPY tests /src/tests
COPY guest/artifacts /src/guest/artifacts
COPY sdk/specification /src/sdk/specification
COPY web/docs/src/content/docs/security /src/web/docs/src/content/docs/security
COPY web/graphics /src/web/graphics
# Every workspace member, or `cargo fetch --locked` cannot load the workspace;
# tests/citadel/test_linux_rust_base_copies_the_workspace.py holds the list.
COPY sdk/rust /src/sdk/rust

WORKDIR /src

# `capsem-app` embeds the current frontend and its Tauri context while Cargo
# prewarms every target. Materialize both JavaScript dependency trees first;
# the sealed lane overlays current source and rebuilds both before Rust.
COPY sdk/typescript /src/sdk/typescript
RUN cd /src/sdk/typescript \
    && CI=true pnpm install --frozen-lockfile \
    && pnpm run build

COPY web/app /src/web/app
COPY build_system/patches /src/build_system/patches
RUN cd /src/web/app \
    && CI=true pnpm install --frozen-lockfile \
    && pnpm run build \
    && test -s /src/web/app/dist/index.html

# `--locked` so a resolution difference fails here, with network, rather than
# inside a lane that has none.
RUN cargo fetch --locked

# The sealed lane compiles as uid 1000. Create its output with that owner
# instead of copying a complete root-owned artifact layer during chown.
# A few upstream crate archives carry private source modes; dependencies
# remain root-owned, with only missing read/traverse permissions repaired.
# tauri-build also writes schemas under capsem-app/gen while Cargo prewarms.
RUN mkdir -p /cargo-target /home/lane /usr/local/cargo/git /src/crates/capsem-app/gen \
    && chown 1000:1000 /cargo-target /home/lane \
    && chown -R 1000:1000 /src/crates/capsem-app/gen \
    && find /usr/local/cargo/registry /usr/local/cargo/git \
        \( -type d ! -perm -005 -o -type f ! -perm -004 \) -exec chmod a+rX {} +
# Incremental intermediates are compiler-session state, not dependencies.
# The old prewarm carried 7 GiB of them, measured twice on its sealed image.
ENV CARGO_INCREMENTAL=0
ENV CARGO_NET_OFFLINE=true
ENV HOME=/home/lane
USER 1000:1000

# The dependency graph, compiled. `cargo fetch` gets the sources; this gets
# the artifacts, which is the part that made a cold run 135s instead of 58s.
RUN cargo build --locked --workspace --all-targets

# Warmed a second time with the coverage instrumentation the lane actually
# uses. `cargo llvm-cov show-env` is the documented way to get exactly the
# RUSTFLAGS and target directory the coverage run will use, so a build under
# them produces artifacts the lane reuses rather than discards.
# Match the lane's no-cfg-coverage mode, and preserve show-env's exit before eval.
#
# This matters because instrumentation changes every build fingerprint:
# warming without these flags would leave the lane recompiling the whole
# dependency graph inside a run that has no network to repair a miss.
#
# An earlier attempt used `--no-run`, which is deprecated: it exited in 0.3s
# with "not found *.profraw files" and a fallback swallowed the failure, so
# nothing was compiled at all and three subsequent "fixes" were built on a
# step that had silently done nothing. A failed prewarm is a failed image.
RUN bash -euc 'coverage_env=$(cargo llvm-cov show-env --sh --no-cfg-coverage) \
    && eval "$coverage_env" \
    && cargo build --locked --workspace --all-targets'

USER root
ENV HOME=/root

# The build-system Python environment, for the Rust tests that hand an export
# to a reference reader (`warcio`) through `uv run --project build_system`.
# Built here, with network, into /src/build_system/.venv; the lane's source
# copy excludes `.venv`, so it survives, and `uv run --frozen` in the sealed
# lane finds it complete. Without it those tests tried to download packages
# inside a lane that has none and failed on DNS.
#
# The uv cache lives under /src too, handed to the lane user below: the lane
# copies a newer build_system/pyproject.toml over this one, and a rebuild of the editable
# project needs its build backend (setuptools) from a cache it can read.
ENV UV_CACHE_DIR=/src/.uv-cache
COPY build_system /src/build_system
RUN cd /src && uv sync --project build_system --frozen
# Offline from here on: the cache holds setuptools, but uv still asks the
# index before using it, and the lane has no network. The lane's copy gives
# the project manifest a new mtime, which uv keys the editable rebuild on,
# so the rebuild happened on every run whose base image was freshly built.
ENV UV_OFFLINE=1

# The lane rebuilds generated SDK/frontend output and writes the two Python
# environment trees retained through `.dockerignore`. Source arrives through
# `COPY --chown` in the thin lane image; inherited generated output needs its
# own writable ownership. Package stores and the Rust toolchain are immutable
# inputs. Recursively changing their ~130,000 entries added
# nearly three minutes to every cold export without granting a needed write.
# A non-root user is required: the suite chmods an asset to 0o000 and demands
# the read fail, and root ignores permissions. `ubuntu:24.04` already ships a
# uid-1000 account, so this uses the numeric id rather than creating one --
# `useradd --uid 1000` exits 4 on a UID that already exists.
RUN mkdir -p /cargo-target /home/lane /linux-rust-output \
    && chown 1000:1000 /cargo-target /home/lane /linux-rust-output \
    && chown -R 1000:1000 /src/.uv-cache /src/build_system/.venv \
        /src/sdk/typescript/dist /src/web/app/dist \
        /src/web/app/.astro /src/web/app/node_modules/.astro

# Identity metadata comes after the final filesystem layer so an input-key
# change never invalidates a filesystem operation.
ARG INPUT_IDENTITY
LABEL org.capsem.linux-rust-base.input-key="${INPUT_IDENTITY}"
LABEL org.opencontainers.image.source="https://github.com/google/capsem"
