# check=skip=InvalidDefaultArgInFrom
# Network-open, input-keyed dependencies for the install qualification image.
ARG BASE
FROM ${BASE} AS dependency-fetch

ARG INSTALL_VENV
ARG RUST_TARGET
ARG PNPM_STORE
ENV RUSTUP_AUTO_INSTALL=0

COPY Cargo.toml Cargo.lock rust-toolchain.toml /prefetch/
COPY .cargo/config.toml /prefetch/.cargo/config.toml
COPY --chmod=555 build_system/scripts/build/rustc-workspace-wrapper.sh /prefetch/build_system/scripts/build/rustc-workspace-wrapper.sh
COPY crates /prefetch/crates
COPY build_system/pyproject.toml build_system/uv.lock /prefetch/build_system/
COPY build_system/release_site/package.json build_system/release_site/pnpm-lock.yaml \
    build_system/release_site/pnpm-workspace.yaml /prefetch/build_system/release_site/

WORKDIR /prefetch
RUN selected="$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)" \
    && test -n "${selected}" \
    && rustup toolchain list | grep -F "${selected}-" \
    && rustup target list --toolchain "${selected}" --installed | grep -Fx "${RUST_TARGET}"
RUN mkdir -p /capsem-deps/cargo/registry /capsem-deps/cargo/git \
    && CARGO_HOME=/capsem-deps/cargo cargo fetch --locked --target "${RUST_TARGET}"
RUN UV_PROJECT_ENVIRONMENT="${INSTALL_VENV}" uv sync --project build_system --locked --no-install-project
RUN cd build_system/release_site && pnpm fetch --frozen-lockfile --store-dir /capsem-deps/pnpm

FROM ${BASE}

ARG APT_SNAPSHOT_BASE
ARG APT_SNAPSHOT_ID
ARG APT_PACKAGES
ARG INSTALL_VENV
ARG CARGO_STORE
ARG PNPM_STORE
ARG APT_LISTS_CACHE_ID
ARG APT_ARCHIVES_CACHE_ID
ARG INPUT_IDENTITY

LABEL org.capsem.install-builder.input-key=${INPUT_IDENTITY}

COPY --chmod=555 build_system/scripts/build/configure-apt-snapshot.sh /usr/local/bin/configure-apt-snapshot
COPY --chmod=555 build_system/docker/materialize-install-os.sh /usr/local/bin/materialize-install-os
RUN test -n "${APT_SNAPSHOT_BASE}" \
    && test -n "${APT_SNAPSHOT_ID}" \
    && test -n "${APT_PACKAGES}" \
    && test -n "${INSTALL_VENV}" \
    && test -n "${CARGO_STORE}" \
    && test -n "${PNPM_STORE}" \
    && test -n "${APT_LISTS_CACHE_ID}" \
    && test -n "${APT_ARCHIVES_CACHE_ID}"
RUN --mount=type=cache,id=${APT_LISTS_CACHE_ID},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=${APT_ARCHIVES_CACHE_ID},target=/var/cache/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && materialize-install-os "${APT_SNAPSHOT_BASE}" "${APT_SNAPSHOT_ID}" ${APT_PACKAGES}

# The privileged proof needs a real systemd userspace but must not disturb
# Colima's host-owned Rosetta binfmt registration when PID 1 starts.
RUN mkdir -p /etc/systemd/system \
    && ln -s /dev/null /etc/systemd/system/systemd-binfmt.service

RUN if getent passwd 1000 >/dev/null 2>&1; then \
        userdel -r "$(getent passwd 1000 | cut -d: -f1)" 2>/dev/null || true; \
    fi \
    && useradd -m -s /bin/bash -u 1000 capsem \
    && echo "capsem ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/capsem

COPY --from=dependency-fetch ${INSTALL_VENV} ${INSTALL_VENV}
COPY --from=dependency-fetch --chown=capsem:capsem /capsem-deps/cargo/registry ${CARGO_STORE}/registry
COPY --from=dependency-fetch --chown=capsem:capsem /capsem-deps/cargo/git ${CARGO_STORE}/git
COPY --from=dependency-fetch --chown=capsem:capsem /capsem-deps/pnpm ${PNPM_STORE}

RUN dbus-daemon --system --fork 2>/dev/null; \
    loginctl enable-linger capsem 2>/dev/null || \
    mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/capsem

RUN mkdir -p /home/capsem/.capsem/bin \
             /home/capsem/.capsem/assets \
             /home/capsem/.capsem/run \
             /home/capsem/.config/systemd/user \
             /run/user/1000 \
    && chown -R capsem:capsem /home/capsem/.capsem /home/capsem/.config /run/user/1000

ENV XDG_RUNTIME_DIR=/run/user/1000
ENV UV_PROJECT_ENVIRONMENT=${INSTALL_VENV}
ENV UV_OFFLINE=true
ENV RUSTUP_AUTO_INSTALL=0
ENV CARGO_NET_OFFLINE=true
ENV CARGO_HOME=${CARGO_STORE}
ENV CAPSEM_INSTALL_PNPM_STORE=${PNPM_STORE}
