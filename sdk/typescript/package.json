{
  "name": "@capsem/sdk",
  "version": "0.7.1",
  "description": "Typed async client for the Capsem HTTP gateway",
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "git+https://github.com/google/capsem.git", "directory": "sdk/typescript"},
  "type": "module",
  "engines": {"node": ">=20"},
  "files": ["dist", "README.md"],
  "imports": {
    "#local": {
      "browser": "./dist/local-browser.js",
      "node": "./dist/local-node.js",
      "default": "./dist/local-browser.js"
    }
  },
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./models": {"types": "./dist/models/index.d.ts", "import": "./dist/models/index.js"},
    "./operations": {"types": "./dist/operations/index.d.ts", "import": "./dist/operations/index.js"},
    "./transport": {"types": "./dist/transport.d.ts", "import": "./dist/transport.js"}
  },
  "scripts": {
    "lint": "eslint src tests tools eslint.config.js vitest.config.ts --max-warnings 0",
    "check": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.browser.json",
    "build": "node tools/build.mjs",
    "prepack": "pnpm run build",
    "pretest": "pnpm run build",
    "prewarm:package": "node tools/prewarm-package.mjs",
    "test": "vitest run --coverage",
    "test:sdk": "vitest run --coverage"
  },
  "dependencies": {"@msgpack/msgpack": "^3.1.3", "zod": "4.6.7"},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.10.0",
    "openai": "7.31.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.12"
  },
  "pnpm": {"overrides": {"esbuild": "0.28.1", "vite": "8.3.3"}}
}
